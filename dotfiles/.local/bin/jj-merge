#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Try Mergiraf first, then open remaining conflicts in jj-diffconflicts."""

import argparse
import difflib
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


class UnsafeConversion(ValueError):
    """The merge cannot safely be represented with native JJ diff markers."""


def convert_diff3(data: bytes, marker_length: int) -> bytes:
    """Convert complete diff3 blocks without changing any ordinary file bytes."""
    if b"\0" in data or b"\r" in data.replace(b"\r\n", b""):
        raise UnsafeConversion("binary data or unsupported line endings")
    lines = data.splitlines(keepends=True)
    marker_like = re.compile(rb"^(?:<{%d,}|\|{%d,}|={%d,}|>{%d,}|%%{%d,}|\+{%d,}|\\{%d,})" % ((marker_length,) * 7))

    def marker(line, char, labelled=True):
        body = line.removesuffix(b"\n").removesuffix(b"\r")
        prefix = char * marker_length
        return body == prefix or (labelled and body.startswith(prefix + b" "))

    blocks = []
    plain = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if not marker(line, b"<"):
            if marker_like.match(line):
                raise UnsafeConversion("unexpected or ambiguous conflict marker")
            plain.append(line)
            index += 1
            continue
        blocks.append(b"".join(plain))
        plain = []
        ending = b"\r\n" if line.endswith(b"\r\n") else b"\n"
        sections = []
        index += 1
        for char, labelled in ((b"|", True), (b"=", False), (b">", True)):
            section = []
            while index < len(lines) and not marker(lines[index], char, labelled):
                if marker_like.match(lines[index]):
                    raise UnsafeConversion("nested, incomplete, or ambiguous conflict")
                if not lines[index].endswith(b"\n"):
                    raise UnsafeConversion("conflict side has no final newline")
                section.append(lines[index])
                index += 1
            if index == len(lines) or not lines[index].endswith(b"\n") or (
                b"\r\n" if lines[index].endswith(b"\r\n") else b"\n"
            ) != ending:
                raise UnsafeConversion("incomplete conflict or mixed marker line endings")
            sections.append(section)
            index += 1
        left, base, right = sections
        blocks.append((base, left, right, ending))
    blocks.append(b"".join(plain))
    count = sum(isinstance(block, tuple) for block in blocks)
    if not count:
        raise UnsafeConversion("Mergiraf returned conflicts without diff3 markers")

    result = []
    number = 0
    for block in blocks:
        if isinstance(block, bytes):
            result.append(block)
            continue
        number += 1
        base, left, right, ending = block

        def emit(char, label):
            result.append(char * marker_length + b" " + label + ending)

        label = f"conflict {number} of {count}".encode()
        emit(b"<", label)
        emit(b"%", b"Changes from base to side #1")
        matcher = difflib.SequenceMatcher(a=base, b=left, autojunk=False)
        for tag, start_a, end_a, start_b, end_b in matcher.get_opcodes():
            if tag == "equal":
                result.extend(b" " + line for line in base[start_a:end_a])
            else:
                result.extend(b"-" + line for line in base[start_a:end_a])
                result.extend(b"+" + line for line in left[start_b:end_b])
        emit(b"+", b"Contents of side #2")
        result.extend(right)
        emit(b">", label + b" ends")
    return b"".join(result)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("base", "left", "right", "output"):
        parser.add_argument(name, type=Path)
    parser.add_argument("marker_length", type=int)
    parser.add_argument("path", help="repository-relative file path for Mergiraf's parser")
    args = parser.parse_args()
    if args.marker_length < 7:
        parser.error("marker_length must be at least 7")
    original = None
    try:
        original = args.output.read_bytes()
        merger = shutil.which("mergiraf")
        if not merger:
            raise OSError("mergiraf is unavailable; install the configured mise tool")
        with tempfile.TemporaryDirectory(prefix="jj-merge-") as directory:
            merged = Path(directory) / "merged"
            status = subprocess.run(
                [merger, "merge", str(args.base), str(args.left), str(args.right),
                 "-o", str(merged), "-l", str(args.marker_length), "-p", args.path, "--fast"],
                check=False,
            ).returncode
            if status not in (0, 1):
                raise OSError(f"Mergiraf failed with exit status {status}")
            candidate = merged.read_bytes()
        if status == 0:
            args.output.write_bytes(candidate)
            return 0

        editor = shutil.which("nvim")
        if not editor:
            raise OSError("nvim is unavailable; the original conflict was preserved")
        try:
            for source in (args.base, args.left, args.right):
                content = source.read_bytes()
                if content and not content.endswith(b"\n"):
                    raise UnsafeConversion("an input has no final newline")
            candidate = convert_diff3(candidate, args.marker_length)
        except UnsafeConversion as error:
            print(f"jj-merge: {error}; opening the original JJ conflict (partial Mergiraf resolutions were not copied).", file=sys.stderr)
            candidate = original
        args.output.write_bytes(candidate)
        status = subprocess.run(
            [editor, "-c", f"let g:jj_diffconflicts_marker_length={args.marker_length}",
             "-c", "JJDiffConflicts!", str(args.output), str(args.base), str(args.left), str(args.right)],
            check=False,
        ).returncode
        if status != 0:
            args.output.write_bytes(original)
        return status if status >= 0 else 128 - status
    except (OSError, KeyboardInterrupt) as error:
        if original is not None:
            args.output.write_bytes(original)
        print(f"jj-merge: {error or 'interrupted'}; original conflict preserved.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
