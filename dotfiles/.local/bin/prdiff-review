#!/usr/bin/env bash
set -euo pipefail

require_command() {
    local command_name="${1:?command name required}"
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        printf 'prdiff-review: required command not found: %s\n' "${command_name}" >&2
        exit 127
    fi
}

require_command gh
require_command diffnav

gh pr diff "$@" | diffnav --side-by-side
