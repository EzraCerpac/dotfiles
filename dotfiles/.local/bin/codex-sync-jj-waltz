#!/usr/bin/env bash
set -euo pipefail

SETUP_SOURCE="${MISE_CONFIG_DIR:-${HOME}/.config/mise}"
SOURCE_SKILL="${JJ_WALTZ_SKILL_SOURCE:-${HOME}/Projects/jj-waltz/skills/jj-waltz}"
DEST_SKILLS=(
    "${SETUP_SOURCE}/dotfiles/.codex/skills/jj-waltz"
    "${SETUP_SOURCE}/dotfiles/.config/opencode/skills/jj-waltz"
)

validate_skill() {
    local skill_dir="${1:?skill directory required}"

    uv run --with pyyaml python - "${skill_dir}" <<'PY'
from pathlib import Path
import re
import sys
from urllib.parse import unquote, urlsplit

import yaml

skill_dir = Path(sys.argv[1])
skill_file = skill_dir / "SKILL.md"
text = skill_file.read_text(encoding="utf-8")

if not text.startswith("---\n"):
    raise SystemExit(f"{skill_file}: missing YAML frontmatter")

try:
    _, frontmatter, body = text.split("---", 2)
except ValueError as exc:
    raise SystemExit(f"{skill_file}: unclosed YAML frontmatter") from exc

metadata = yaml.safe_load(frontmatter)
if not isinstance(metadata, dict):
    raise SystemExit(f"{skill_file}: frontmatter must be a mapping")
if metadata.get("name") != skill_dir.name:
    raise SystemExit(f"{skill_file}: name must be {skill_dir.name!r}")
if not isinstance(metadata.get("description"), str) or not metadata["description"].strip():
    raise SystemExit(f"{skill_file}: description is required")
if not body.strip():
    raise SystemExit(f"{skill_file}: body is required")

runtime_files = [skill_file]
for directory in ("references", "agents", "assets"):
    runtime_files.extend((skill_dir / directory).rglob("*.md"))
root = skill_dir.resolve()
for document in runtime_files:
    for match in re.finditer(r'\[[^\]]*\]\((?:<([^>]+)>|([^\s)]+))[^)]*\)', document.read_text()):
        target = match.group(1) or match.group(2)
        parsed = urlsplit(target)
        if parsed.scheme or parsed.netloc or not parsed.path:
            continue
        resolved = (document.parent / unquote(parsed.path)).resolve()
        if not resolved.is_relative_to(root) or not resolved.exists():
            raise SystemExit(f"{document}: missing or external local link: {target}")
        relative = resolved.relative_to(root)
        if relative.parts[0] not in ("SKILL.md", "references", "agents", "assets"):
            raise SystemExit(f"{document}: link is not distributed: {target}")

print("Skill is valid!")
PY
}

if [[ ! -f "${SOURCE_SKILL}/SKILL.md" ]]; then
    echo "Source skill not found: ${SOURCE_SKILL}" >&2
    exit 1
fi

validate_skill "${SOURCE_SKILL}"

for DEST_SKILL in "${DEST_SKILLS[@]}"; do
    mkdir -p "${DEST_SKILL}"

    rsync -a --delete \
        --include '/SKILL.md' \
        --include '/agents/' \
        --include '/agents/***' \
        --include '/assets/' \
        --include '/assets/***' \
        --include '/references/' \
        --include '/references/***' \
        --exclude '*' \
        "${SOURCE_SKILL}/" "${DEST_SKILL}/"

    validate_skill "${DEST_SKILL}"
done

echo "Synced jj-waltz into mise source:"
for DEST_SKILL in "${DEST_SKILLS[@]}"; do
    echo "  ${DEST_SKILL}"
done
echo
echo "Next:"
echo "  mise bootstrap dotfiles diff ~/.codex/skills/jj-waltz ~/.config/opencode/skills/jj-waltz"
echo "  mise bootstrap dotfiles apply ~/.codex/skills/jj-waltz ~/.config/opencode/skills/jj-waltz"
