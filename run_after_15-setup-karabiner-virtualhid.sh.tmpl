#!/usr/bin/env bash

set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}

KARABINER_MANAGER="/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager"
KARABINER_DAEMON="/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Daemon"
KARABINER_LABEL="org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon"
KARABINER_CORE_LABEL="org.pqrs.service.daemon.Karabiner-Core-Service"
KARABINER_LEGACY_LABEL="org.pqrs.Karabiner-VirtualHIDDevice-Daemon.chezmoi"
KARABINER_LEGACY_PLIST="/Library/LaunchDaemons/org.pqrs.Karabiner-VirtualHIDDevice-Daemon.chezmoi.plist"
KARABINER_CORE_LEGACY_PLIST="/Library/LaunchDaemons/org.pqrs.service.daemon.Karabiner-Core-Service.plist"

if [[ ! -x "${KARABINER_MANAGER}" ]] || [[ ! -x "${KARABINER_DAEMON}" ]]; then
    echo "Karabiner VirtualHID components not installed yet; skipping setup"
    exit 0
fi

if ! systemextensionsctl list | grep -q "org.pqrs.Karabiner-DriverKit-VirtualHIDDevice"; then
    echo "Activating Karabiner VirtualHID driver..."
    if ! sudo "${KARABINER_MANAGER}" activate >/dev/null 2>&1; then
        echo "Could not activate the Karabiner VirtualHID driver automatically"
        echo "Run: sudo ${KARABINER_MANAGER} activate"
    fi
fi

if sudo launchctl print "system/${KARABINER_LEGACY_LABEL}" >/dev/null 2>&1; then
    echo "Removing legacy chezmoi Karabiner VirtualHID daemon..."
    sudo launchctl bootout "system/${KARABINER_LEGACY_LABEL}" >/dev/null 2>&1 || true
fi

if [[ -f "${KARABINER_LEGACY_PLIST}" ]]; then
    echo "Removing ${KARABINER_LEGACY_PLIST}"
    sudo rm -f "${KARABINER_LEGACY_PLIST}" || true
fi

if [[ -f "${KARABINER_CORE_LEGACY_PLIST}" ]]; then
    echo "Removing legacy Karabiner Core-Service plist; Karabiner manages this through ServiceManagement"
    sudo rm -f "${KARABINER_CORE_LEGACY_PLIST}" || true
fi

if launchctl print "system/${KARABINER_LABEL}" >/dev/null 2>&1; then
    echo "Karabiner VirtualHID daemon is managed by Karabiner"
else
    echo "Karabiner VirtualHID daemon is not running under ${KARABINER_LABEL}"
    echo "Open Karabiner-Elements once, then check: launchctl print system/${KARABINER_LABEL}"
fi

if launchctl print "system/${KARABINER_CORE_LABEL}" >/dev/null 2>&1; then
    echo "Karabiner Core-Service is managed by Karabiner"
else
    echo "Karabiner Core-Service is not running under ${KARABINER_CORE_LABEL}"
fi

{{- end }}
