#!/usr/bin/env bash
set -euo pipefail
source "${DOTS_HOME:-$(dirname "$0")/../../manager}/lib/setup-common.sh"
setup_init
if [[ "${SETUP_NAS_NEOVIM_BUILD:-0}" != 1 ]]; then
    printf 'Neovim source build is not needed on this host.\n'
    exit 0
fi
exec bash "$SETUP_ROOT/setup-scripts/install/nas-neovim-source.sh"
