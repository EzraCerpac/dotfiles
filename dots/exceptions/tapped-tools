#!/usr/bin/env bash
set -euo pipefail
if [[ "$(uname -s)" != Darwin ]]; then
    # The v0.4 updater exports DOTS_HOME and treats exit 4 as an error here.
    [[ -z "${DOTS_HOME:-}" ]] && exit 4
    exit 0
fi
for formula in felixkratz/formulae/borders dastrobu/tap/mail-mcp ezracerpac/tap/typst-time-machine; do
    dots brew update-formula "$formula" "$@"
done
