#!/usr/bin/env bash
set -euo pipefail

# Intel macOS only: mise's brew bootstrap backend skips darwin/amd64
# (upstream jdx/mise#10968), so these formulae need an explicit owner there.
# btop belongs to NAS hosts only; other hosts get their declared packages.
if [[ "$(uname -s)" != Darwin || "$(uname -m)" != x86_64 ]]; then
    printf 'Deferred: intel-brew-basics applies to Intel macOS only.\n'
    exit 0
fi

for formula in fish git; do
    dots brew update-formula "$formula" "$@"
done
if [[ "${SETUP_PROFILE:-}" == nas ]]; then
    dots brew update-formula btop "$@"
fi
