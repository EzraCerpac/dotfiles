#!/usr/bin/env bash
set -euo pipefail

usage() { printf 'usage: dots atuin-bundle --recipient age1... [--recipient age1...]\n'; }

root="${DOTS_ROOT:?run through dots atuin-bundle}"
output="$root/encrypted/atuin.json.age"
args=()
while (($#)); do
    case "$1" in
        --recipient)
            (($# >= 2)) || { usage >&2; exit 2; }
            args+=(--recipient "$2")
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done
(("${#args[@]}")) || { printf 'Supply the authorized public age recipients with --recipient.\n' >&2; exit 2; }
[[ ! -e "$output" && ! -L "$output" ]] || { printf 'The output already exists. Review it before replacing it.\n' >&2; exit 2; }

printf 'Output: %s\n' "$output"
for ((i = 1; i < ${#args[@]}; i += 2)); do
    printf 'Authorized recipient: %s\n' "${args[i]}"
done
printf 'Atuin password: ' >&2
unset password
IFS= read -rs password || true
printf '\n' >&2
[[ -n "${password:-}" ]] || { printf 'The password cannot be empty.\n' >&2; exit 2; }
printf '%s' "$password" | dots mise exec -- uv run --no-project python "$root/dots/lib/atuin.py" bundle --output "$output" "${args[@]}"
