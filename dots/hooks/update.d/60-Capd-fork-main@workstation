#!/usr/bin/env bash
# Rebuild and reinstall a changed Capd fork main (macOS only).
set -euo pipefail
if [[ "$(uname -s 2>/dev/null || true)" != Darwin ]]; then
    printf 'Skipped: Capd fork main (macOS only).\n'
    exit 4
fi
exec bash "${DOTS_ROOT:?run through dots}/setup-scripts/local/capd-update.sh"
