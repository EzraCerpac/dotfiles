#!/usr/bin/env bash
# Initialize Neovim once private settings exist; dotfiles seeded lazyvim.json.
set -euo pipefail
root="${DOTS_ROOT:?run through dots}"
deferred() {
    printf 'Complete configuration recovery before initializing Neovim.\n'
    exit 3
}
[[ "${DOTS_PRIVATE_READY:-0}" == 1 ]] || deferred
if [[ "${DOTS_RESTORED:-0}" == 1 ]]; then
    # A restore can remove a seed its checkpoint recorded as absent; put it back
    # (create_if_missing leaves an existing file alone) before Neovim writes its default.
    MISE_CONFIG_DIR="$root" mise bootstrap dotfiles apply --yes "$HOME/.config/nvim/lazyvim.json" >/dev/null || deferred
fi
exec bash "$root/setup-scripts/setup/nvim-initialize"
