#!/usr/bin/env bash
# Initialize Neovim once private settings and missing public defaults exist.
set -euo pipefail
root="${DOTS_ROOT:?run through dots}"
deferred() {
    printf 'Complete configuration recovery before initializing Neovim.\n'
    exit 3
}
[[ "${DOTS_PRIVATE_READY:-0}" == 1 ]] || deferred
if [[ "${DOTS_RESTORED:-0}" == 1 ]]; then
    # Neovim must not create a default lazyvim.json before the restored host's
    # missing public defaults are seeded (seeding only creates missing files).
    env -u SETUP_RESTORE_MACHINE_ID bash "$root/setup-scripts/local/seed-configs.sh" >/dev/null || deferred
fi
exec bash "$root/setup-scripts/setup/nvim-initialize"
