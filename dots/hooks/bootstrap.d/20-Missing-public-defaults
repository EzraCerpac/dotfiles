#!/usr/bin/env bash
# After a restore, seed public defaults the restored settings did not supply.
# Hosts that did not restore seed them before dotfiles (pre-dotfiles hook).
set -euo pipefail
if [[ "${DOTS_RESTORED:-0}" != 1 ]]; then
    printf 'Skipped: public defaults were seeded before dotfiles.\n'
    exit 4
fi
if [[ "${DOTS_PRIVATE_READY:-0}" != 1 ]]; then
    printf 'Skipped: public defaults wait for private settings recovery.\n'
    exit 4
fi
exec env -u SETUP_RESTORE_MACHINE_ID bash "${DOTS_ROOT:?run through dots}/setup-scripts/local/seed-configs.sh"
