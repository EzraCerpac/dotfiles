#!/usr/bin/env bash
# Run this configuration's test suites: tests/run [python|node ...]
#
# These test the configuration (declarations, docs, scripts); the dots manager
# is tested in its own repository, EzraCerpac/dots. A suite is skipped (exit status 77)
# when its runtime is missing. The run is isolated from the caller's Git and JJ
# configuration so personal settings (signing, pagers, default branches) cannot
# change fixture behavior.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly root
readonly all_suites=(python node)

usage() {
    printf 'usage: tests/run [%s ...]\n' "$(IFS='|'; printf '%s' "${all_suites[*]}")"
}

suites=()
for argument in "$@"; do
    case "$argument" in
        -h|--help) usage; exit 0 ;;
        python|node) suites+=("$argument") ;;
        *) usage >&2; exit 2 ;;
    esac
done
[[ ${#suites[@]} -gt 0 ]] || suites=("${all_suites[@]}")

isolation="$(mktemp -d "${TMPDIR:-/tmp}/setup-tests.XXXXXX")"
trap 'rm -rf "$isolation"' EXIT
printf '[user]\n\tname = Setup Tests\n\temail = setup-tests@example.invalid\n' >"$isolation/gitconfig"
printf '[user]\nname = "Setup Tests"\nemail = "setup-tests@example.invalid"\n' >"$isolation/jj.toml"
export GIT_CONFIG_GLOBAL="$isolation/gitconfig" GIT_CONFIG_NOSYSTEM=1 JJ_CONFIG="$isolation/jj.toml"
unset MISE_ENV

passed=()
failed=()
skipped=()

record() {
    local name="$1" status="$2"
    case "$status" in
        0) passed+=("$name") ;;
        77) skipped+=("$name") ;;
        *) failed+=("$name") ;;
    esac
}

run_python() {
    local status=0
    python3 -m unittest discover -s "$root/tests" -p 'test_*.py' || status=$?
    record python "$status"
}

run_node() {
    local status=0
    local files=("$root"/tests/*.mjs)
    if [[ ! -e "${files[0]}" ]]; then
        echo 'no Node test files'
        record node 0
        return
    fi
    if ! command -v node >/dev/null 2>&1; then
        record node 77
        return
    fi
    node --test "${files[@]}" || status=$?
    record node "$status"
}

for suite in "${suites[@]}"; do
    printf '\n### %s\n' "$suite"
    "run_$suite"
done

printf '\n### summary\n'
printf 'passed:  %d\n' "${#passed[@]}"
if [[ ${#skipped[@]} -gt 0 ]]; then printf 'skipped: %s\n' "${skipped[*]}"; fi
if [[ ${#failed[@]} -gt 0 ]]; then
    printf 'FAILED:  %s\n' "${failed[*]}"
    exit 1
fi
