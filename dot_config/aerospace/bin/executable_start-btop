#!/usr/bin/env bash
set -euo pipefail

AEROSPACE=${AEROSPACE:-/opt/homebrew/bin/aerospace}
BTOP=${BTOP:-/opt/homebrew/bin/btop}
OPEN_BIN=${OPEN_BIN:-/usr/bin/open}
WEZTERM_APP=${WEZTERM_APP:-/Applications/WezTerm.app}
LOCKF=${LOCKF:-/usr/bin/lockf}
LOCK_PATH=${START_BTOP_LOCK_PATH:-${TMPDIR:-/tmp}/start-btop.lock}
TIMER_STATE=${START_BTOP_TIMER_STATE:-${TMPDIR:-/tmp}/start-btop.timer}
CLOSE_AFTER=${START_BTOP_CLOSE_AFTER:-60}

focus_workspace=false
case "${1:-}" in
    "") ;;
    --focus) focus_workspace=true ;;
    --expire)
        [[ $# -eq 3 ]] || exit 2
        ;;
    *)
        echo "usage: start-btop [--focus]" >&2
        exit 2
        ;;
esac

if [[ ${START_BTOP_LOCKED:-0} != 1 ]]; then
    exec "$LOCKF" -k "$LOCK_PATH" /usr/bin/env START_BTOP_LOCKED=1 /bin/bash "$0" "$@"
fi

find_btop_window() {
    "$AEROSPACE" list-windows --all \
        --format $'%{window-id}\t%{app-name}\t%{window-title}%{newline}' \
        | awk -F $'\t' 'tolower($2) ~ /wezterm/ && tolower($3) ~ /^btop([[:space:]]|$)/ && !found { print $1; found = 1 }'
}

is_btop_window() {
    local expected_window=$1
    "$AEROSPACE" list-windows --all \
        --format $'%{window-id}\t%{app-name}\t%{window-title}%{newline}' \
        | awk -F $'\t' -v expected="$expected_window" \
            '$1 == expected && tolower($2) ~ /wezterm/ && tolower($3) ~ /^btop([[:space:]]|$)/ { found = 1 } END { exit !found }'
}

expire_btop_window() {
    local expected_window=$1
    local expected_generation=$2
    local scheduled_window=
    local scheduled_generation=

    [[ -f "$TIMER_STATE" ]] || exit 0
    IFS=$'\t' read -r scheduled_window scheduled_generation < "$TIMER_STATE" || exit 0
    [[ $scheduled_window == "$expected_window" && $scheduled_generation == "$expected_generation" ]] || exit 0

    if is_btop_window "$expected_window"; then
        "$AEROSPACE" close --window-id "$expected_window"
    fi
    rm -f "$TIMER_STATE"
}

schedule_close() {
    local window_id=$1
    local generation="$$-$RANDOM-$RANDOM"

    umask 077
    printf '%s\t%s\n' "$window_id" "$generation" > "$TIMER_STATE"
    (
        sleep "$CLOSE_AFTER"
        /usr/bin/env START_BTOP_LOCKED=0 \
            AEROSPACE="$AEROSPACE" \
            START_BTOP_LOCK_PATH="$LOCK_PATH" \
            START_BTOP_TIMER_STATE="$TIMER_STATE" \
            /bin/bash "$0" --expire "$window_id" "$generation"
    ) </dev/null >/dev/null 2>&1 &
}

if [[ ${1:-} == --expire ]]; then
    expire_btop_window "$2" "$3"
    exit 0
fi

existing_window=$(find_btop_window)

if [[ -n "$existing_window" ]]; then
    "$AEROSPACE" move-node-to-workspace 9 --window-id "$existing_window"
    if $focus_workspace; then
        "$AEROSPACE" workspace 9
    fi
    schedule_close "$existing_window"
    exit 0
fi

focused_workspace=$("$AEROSPACE" list-workspaces --focused)
"$OPEN_BIN" -na "$WEZTERM_APP" --args start -- "$BTOP"

# ponytail: poll after launch; AeroSpace callback can run before WezTerm publishes its title.
window_id=
for _ in {1..200}; do
    window_id=$(find_btop_window)
    [[ -n "$window_id" ]] && break
    sleep 0.1
done

if [[ -z "$window_id" ]]; then
    echo "start-btop: WezTerm window not detected" >&2
    exit 1
fi

"$AEROSPACE" move-node-to-workspace 9 --window-id "$window_id"
if $focus_workspace; then
    "$AEROSPACE" workspace 9
else
    "$AEROSPACE" workspace "$focused_workspace"
fi
schedule_close "$window_id"
