#!/usr/bin/env bash

set -euo pipefail

{{- if and (eq .chezmoi.os "darwin") (ne .profile "nas") (ne .profile "delftblue") }}

# Keep ordinary Mission Control shortcuts, gestures, and Hot Corners, but do
# not trigger it when a window or Aegis item touches the top edge.
defaults write com.apple.dock enterMissionControlByTopWindowDrag -bool false
killall Dock >/dev/null 2>&1 || true

{{- else }}
echo "Mission Control top-edge configuration is not applicable on this host."
{{- end }}
