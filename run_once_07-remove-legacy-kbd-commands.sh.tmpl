#!/usr/bin/env bash
set -euo pipefail

{{- if eq .profile "nas" }}
echo "CerpacNAS profile detected; skipping workstation keyboard cleanup."
exit 0
{{- else }}

rm -f \
    "${HOME}/.local/bin/kbd-build" \
    "${HOME}/.local/bin/kbd-build-all" \
    "${HOME}/.local/bin/kbd-build-left" \
    "${HOME}/.local/bin/kbd-build-right" \
    "${HOME}/.local/bin/kbd-flash-left" \
    "${HOME}/.local/bin/kbd-flash-right" \
    "${HOME}/.local/bin/kbd-hud-reload" \
    "${HOME}/.local/bin/kbd-layout-images" \
    "${HOME}/.local/bin/kbd-open-artifacts" \
    "${HOME}/.local/bin/kbd-setup" \
    "${HOME}/.local/bin/kbd-sync"
{{- end }}
