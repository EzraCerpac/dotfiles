#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../../lib/brew-exception.sh"

# Intel macOS only: mise's brew bootstrap backend skips darwin/amd64
# (upstream jdx/mise#10968), so these base formulae need an explicit owner
# there. Other hosts get them through [bootstrap.packages] or not at all.
if [[ "$(uname -s)" != Darwin || "$(uname -m)" != x86_64 ]]; then
    printf 'Deferred: intel-brew-basics applies to Intel macOS only.\n'
    exit 0
fi

brew_bin="$(find_real_brew)" || {
    echo "A standard-prefix Homebrew installation is required for exception intel-brew-basics" >&2
    exit 1
}
HOMEBREW_NO_AUTOREMOVE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 \
    "$brew_bin" tap modem-dev/tap https://github.com/modem-dev/homebrew-tap >/dev/null 2>&1 || true

for formula in fish git modem-dev/tap/diffnav; do
    update_brew_formula_exception "$formula" "${1:-}"
done
