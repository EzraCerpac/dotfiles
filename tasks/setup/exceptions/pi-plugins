#!/usr/bin/env bash
set -euo pipefail

agent_dir="${HOME}/.pi/agent"
settings_file="${agent_dir}/settings.json"
install_root="${agent_dir}/npm/node_modules"
sources=(
    "npm:@ollama/pi-web-search"
    "npm:caveman-pi"
    "npm:pi-constell-plan"
    "npm:pi-markdown-preview"
    "npm:pi-mono-btw"
)

if [[ ! -r "${settings_file}" ]]; then
    echo "Pi settings file is missing: ${settings_file}" >&2
    exit 1
fi

if ! command -v pi >/dev/null 2>&1; then
    echo "Pi CLI not found; install @earendil-works/pi-coding-agent first" >&2
    exit 1
fi

# Pi reads these refs from user settings. --no-approve excludes project-local
# settings, and PI_CODING_AGENT_DIR keeps installs in the stable user package root.
configured_packages="$(PI_CODING_AGENT_DIR="${agent_dir}" pi list --no-approve)"
for source in "${sources[@]}"; do
    if ! grep -Fq -- "${source}" <<<"${configured_packages}"; then
        echo "Pi user settings do not list ${source}" >&2
        exit 1
    fi
done

# Pi update installs missing user packages into ~/.pi/agent/npm/node_modules,
# independent of the current Node installation's global npm prefix.
for source in "${sources[@]}"; do
    if [[ "${1:-}" == --install-only && -d "${install_root}/${source#npm:}" ]]; then
        printf 'Already installed: %s\n' "$source"
        continue
    fi
    PI_CODING_AGENT_DIR="${agent_dir}" pi update "${source}" --no-approve
done

for source in "${sources[@]}"; do
    package="${source#npm:}"
    if [[ ! -d "${install_root}/${package}" ]]; then
        echo "Pi package did not install under ${install_root}: ${package}" >&2
        exit 1
    fi
done
