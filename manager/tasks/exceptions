#!/usr/bin/env bash
# MISE description="Install missing installer exceptions without upgrading them"
set -euo pipefail

source "$(dirname "$0")/../lib/setup-common.sh"
setup_init || exit $?
failures=0
install_exception() {
    local name="$1" executable="$2"
    printf 'Installer exception: %s\n' "$name"
    if ! setup_mise exec -- "$executable" --install-only; then
        printf 'Failed installer exception: %s\n' "$name" >&2
        failures=$((failures + 1))
    fi
}
setup_each_exception install_exception
[[ "$failures" -eq 0 ]]
