#!/usr/bin/env bash

set -euo pipefail

# Install versioned tools. OS packages live in run_onchange_03-install-packages.sh.tmpl.

echo "Installing tools..."

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

{{- if eq .profile "delftblue" }}
echo "DelftBlue profile detected; skipping workstation tool installation."
echo "Prefer 'module load {{ .delftblue.module_stack }} ...' inside jobs or interactive allocations."
exit 0
{{- end }}

if ! command -v herdr &>/dev/null; then
    echo "Installing Herdr..."
    curl -fsSL https://herdr.dev/install.sh | sh
fi

# --- Versioned runtimes and pinned tools via mise ---
# Tools defined in ~/.config/mise/config.toml

if command -v mise &>/dev/null; then
    echo "Installing versioned tools via mise..."
    mise install --yes
    echo "mise tools installed"

    if mise exec uv -- uv tool install --upgrade keymap-drawer; then
        echo "keymap-drawer installed via uv"
    else
        echo "Warning: could not install keymap-drawer via uv"
    fi

else
    echo "Warning: mise not found, skipping mise tools"
fi

if command -v npm &>/dev/null; then
    if npm install --global @zed-industries/codex-acp; then
        echo "codex-acp installed via npm"
    else
        echo "Warning: could not install codex-acp via npm"
    fi
else
    echo "Warning: npm not found, skipping codex-acp"
fi

echo "Tools installation complete"
