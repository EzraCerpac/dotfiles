#!/usr/bin/env bash

set -euo pipefail

# Setup shell after applying configurations

echo "Setting up shell configuration..."

export PATH="${HOME}/.local/bin:${PATH}"

{{- if eq .profile "delftblue" }}
echo "DelftBlue profile detected; leaving the default login shell unchanged."
echo "Shell setup complete"

cat << 'EOF'

DelftBlue dotfiles ready
Next: restart terminal | source ~/.bashrc | dbacct

EOF
exit 0
{{- end }}

CURRENT_USER_SHELL=""
if [[ "${OSTYPE}" == darwin* ]]; then
    CURRENT_USER_SHELL="$(dscl . -read "/Users/${USER}" UserShell 2>/dev/null | awk '{print $2}' || true)"
elif command -v getent &>/dev/null; then
    CURRENT_USER_SHELL="$(getent passwd "${USER}" | cut -d: -f7 || true)"
else
    CURRENT_USER_SHELL="${SHELL:-}"
fi

# Prefer fish as login shell when present; fall back to xonsh.
if command -v fish &>/dev/null; then
    SHELL_NAME="fish"
    TARGET_SHELL_PATH="$(which fish)"
elif command -v xonsh &>/dev/null; then
    SHELL_NAME="xonsh"
    TARGET_SHELL_PATH="$(which xonsh)"
else
    SHELL_NAME=""
    TARGET_SHELL_PATH=""
fi

if [[ -n "${TARGET_SHELL_PATH}" ]]; then
    if ! grep -qF "$TARGET_SHELL_PATH" /etc/shells 2>/dev/null; then
        echo "Adding ${SHELL_NAME} to /etc/shells (requires sudo)..."
        echo "$TARGET_SHELL_PATH" | sudo tee -a /etc/shells >/dev/null 2>&1 || \
            echo "Could not add ${SHELL_NAME} to /etc/shells. Run: echo $TARGET_SHELL_PATH | sudo tee -a /etc/shells"
    fi

    if [[ "${CURRENT_USER_SHELL}" != "${TARGET_SHELL_PATH}" ]]; then
        echo "Setting ${SHELL_NAME} as the default shell..."
        if chsh -s "${TARGET_SHELL_PATH}" >/dev/null 2>&1; then
            echo "Default shell set to ${SHELL_NAME}"
        else
            echo "Could not change the default shell automatically. Run:"
            echo "  chsh -s ${TARGET_SHELL_PATH}"
        fi
    fi
fi

# Hint about mise activation
if command -v mise &>/dev/null; then
    echo "mise is installed. Versioned tools are managed via ~/.config/mise/config.toml"
fi

echo "Shell setup complete"

cat << 'EOF'

Dotfiles setup complete
Next: restart terminal | chezmoi doctor | chezmoi update

EOF
