#!/usr/bin/env bash

set -euo pipefail

# Package data fingerprint:
# {{ .packages | toJson }}

echo "Installing declarative packages..."

{{- if eq .profile "delftblue" }}
echo "DelftBlue profile detected; skipping workstation packages."
exit 0
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

BREW_BIN=""
if [[ -x /opt/homebrew/bin/brew ]]; then
    BREW_BIN="/opt/homebrew/bin/brew"
elif [[ -x /usr/local/bin/brew ]]; then
    BREW_BIN="/usr/local/bin/brew"
elif command -v brew &>/dev/null; then
    BREW_BIN="$(command -v brew)"
fi

if [[ -z "${BREW_BIN}" ]]; then
    echo "Warning: Homebrew not found, skipping Homebrew packages"
    exit 0
fi

eval "$("${BREW_BIN}" shellenv)"

{{- range .packages.darwin.taps }}
"${BREW_BIN}" tap {{ quote . }} || true
{{- end }}
{{- range .packages.darwin.trusted_taps }}
"${BREW_BIN}" trust --tap {{ quote . }} || true
{{- end }}

"${BREW_BIN}" bundle install --file=- <<'BREWFILE'
{{- range .packages.darwin.taps }}
tap "{{ . }}"
{{- end }}
{{- range .packages.darwin.brews }}
brew "{{ . }}"
{{- end }}
{{- range .packages.darwin.casks }}
cask "{{ . }}"
{{- end }}
BREWFILE

if "${BREW_BIN}" list felixkratz/formulae/sketchybar >/dev/null 2>&1; then
    "${BREW_BIN}" services restart sketchybar >/dev/null 2>&1 || true
fi

{{- end }}

{{- if eq .chezmoi.os "linux" }}

if command -v apt-get &>/dev/null; then
    echo "Installing system packages via apt-get..."
    sudo apt-get update -qq
    sudo apt-get install -y \
{{- range .packages.linux.apt }}
        {{ . }} \
{{- end }}
        ;
else
    echo "Warning: apt-get not found, skipping system packages"
fi

{{- end }}

echo "Declarative package installation complete"
