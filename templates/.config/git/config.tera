[user]
	name = {{ vars.name }}
	email = {{ vars.email }}
{%- if vars.profile != "nas" %}
	signingkey = {{ env.HOME }}/.ssh/id_ed25519.pub
{%- endif %}
[core]
	excludesfile = {{ env.HOME }}/.gitignore
	autocrlf = input
	pager = hunk pager
	compression = 9
	preloadindex = true
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = gh:
[url "git@github.com:EzraCerpac/"]
	insteadOf = ec:
[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false
[status]
	branch = true
	showStash = true
[commit]
	verbose = true
[diff]
	algorithm = histogram
	context = 3
	renames = copies
	interHunkContext = 10
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[mergetool]
	keepBackup = false
[pager]
	show = delta --side-by-side --paging=never
[delta]
	side-by-side = true
	navigate = true
[interactive]
	diffFilter = delta --side-by-side --paging=never
	singleKey = true
[alias]
	staash = stash --all
	blameC = blame -w -C -C -C
[rerere]
	enabled = true
[column]
	ui = auto
[fetch]
	prune = true
	writeCommitGraph = true
[push]
	autoSetupRemote = true
	default = current
	followTags = true
	recurseSubmodules = on-demand
[pull]
	rebase = false
[rebase]
	autoStash = true
	missingCommitsCheck = warn
	updateRefs = true
[submodule]
	recurse = true
[log]
	abbrevCommit = true
	graphColors = blue, yellow, cyan, magenta, green, red
[branch]
	sort = -committerdate
[tag]
	sort = -taggerdate
[color "branch"]
	current = magenta
	local = {% if vars.profile == "nas" %}blue{% else %}default{% endif %}
	remote = yellow
	upstream = green
	plain = blue
[color "diff"]
	meta = black bold
	frag = magenta
	context = white
	whitespace = yellow reverse
	old = red
[color "decorate"]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta
{%- if vars.profile != "nas" %}
# Workstation integrations: SSH signing, LFS, and per-service credentials.
[gpg]
	format = ssh
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[includeIf "gitdir:{{ env.HOME }}/PhpstormProjects/"]
	path = {{ env.HOME }}/PhpstormProjects/.gitconfig
[credential "https://git.overleaf.com"]
	helper = cache
	username = e.cerpac@student.tudelft.nl
{%- if os() == "macos" %}
[credential]
	helper = osxkeychain
{%- endif %}
{%- endif %}
