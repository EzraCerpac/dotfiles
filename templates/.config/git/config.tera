[user]
	name = Ezra Cerpac
	email = 47384389+EzraCerpac@users.noreply.github.com
{%- if vars.profile == "nas" %}
[core]
	excludesfile = {{ env.HOME }}/.gitignore
	autocrlf = input
	compression = 9
	pager = hunk pager
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = gh:
[url "git@github.com:EzraCerpac/"]
	insteadOf = ec:
[status]
	branch = true
[color "branch"]
	current = magenta
	local = blue
	remote = yellow
	upstream = green
	plain = blue
[merge]
    tool = nvimdiff
[mergetool]
    keepBackup = false
[pager]
    diff = diffnav --side-by-side
    show = delta --side-by-side --paging=never
[delta]
    side-by-side = true
    navigate = true
{%- else %}
	signingkey = D041C1286F71DBDF
[commit]
; 	gpgSign = true
{%- if vars.profile != "delftblue" %}
[includeIf "gitdir:{{ env.HOME }}/PhpstormProjects/"]
	path = {{ env.HOME }}/PhpstormProjects/.gitconfig
{%- endif %}
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	excludesfile = {{ env.HOME }}/.gitignore
	autocrlf = input
	pager = hunk pager
	compression = 9
	whitespace = error
	preloadindex = true
[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false
[init]
	defaultBranch = main
[credential "https://git.overleaf.com"]
	helper = cache
	username = e.cerpac@student.tudelft.nl
[url "git@github.com:"]
	insteadOf = "gh:"
[url "git@github.com:EzraCerpac/"]
	insteadOf = "ec:"
[status]
	branch = true
	showStash = true
[diff]
	context = 3
	renames = copies
	interHunkContext = 10
{%- if vars.profile != "delftblue" %}
[merge]
    tool = nvimdiff
[mergetool]
    keepBackup = false
[pager]
	diff = diffnav --side-by-side
	show = delta --side-by-side --paging=never
[delta]
	side-by-side = true
	navigate = true
{%- endif %}
[color "diff"]
	meta = black bold
	frag = magenta
	context = white
	whitespace = yellow reverse
	old = red
[http]
	postBuffer = 524288000
	maxRequests = 20
	version = HTTP/1.1
[interactive]
{%- if vars.profile != "delftblue" %}
	diffFilter = delta --side-by-side --paging=never
{%- endif %}
	singleKey = true
[alias]
	staash = stash --all
	blameC = blame -w -C -C -C
[rerere]
	enabled = true
[column]
	ui = auto
[fetch]
	writeCommitGraph = true
[push]
	autoSetupRemote = true
	default = current
	followTags = true
	recurseSubmodules = on-demand
[pull]
	default = current
	rebase = false
[rebase]
	autoStash = true
	missingCommitsCheck = warn
	updateRefs = true
[log]
	abbrevCommit = true
	graphColors = blue, yellow, cyan, magenta, green, red
[color "decorate"]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta
[branch]
	sort = -committerdate
[tag]
	sort = -taggerdate
[color "branch"]
	current = magenta
{%- if vars.profile == "nas" %}
	local = blue
{%- else %}
	local = default
{%- endif %}
	remote = yellow
	upstream = green
	plain = blue
{%- if os() == "macos" %}
[credential]
	helper = osxkeychain
{%- endif %}
[submodule]
	recurse = true
{%- endif %}
