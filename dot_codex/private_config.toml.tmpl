model = "gpt-5.6-sol"
model_reasoning_effort = "high"
personality = "pragmatic"
sandbox_mode = "workspace-write"
approval_policy = "never"

[projects."/root/Projects"]
trust_level = "trusted"
{{- if eq .profile "nas" }}

[projects."/root"]
trust_level = "trusted"
{{- end }}

[features]
multi_agent = true
prevent_idle_sleep = true
terminal_resize_reflow = true
