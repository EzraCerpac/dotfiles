#!/usr/bin/env bash

set -euo pipefail

{{- if ne .chezmoi.os "darwin" }}
echo "Antinote bridge is macOS-only; skipping build."
exit 0
{{- else }}

readonly SOURCE_DIR="$HOME/.local/share/personal-concierge/antinote-bridge"
readonly SOURCE_FILE="$SOURCE_DIR/main.swift"
readonly INSTALL_DIR="$HOME/.local/libexec/antinote"
readonly INSTALL_PATH="$INSTALL_DIR/antinote"
readonly STATE_DIR="$HOME/.local/state/chezmoi/tool-reconcile"
readonly MARKER="$STATE_DIR/antinote-bridge"
readonly SOURCE_FINGERPRINT="{{ include "dot_local/share/personal-concierge/antinote-bridge/main.swift" | sha256sum }}"

if [[ -f "$MARKER" && "$(<"$MARKER")" == "$SOURCE_FINGERPRINT" && -x "$INSTALL_PATH" ]]; then
    exit 0
fi

if ! command -v swiftc >/dev/null 2>&1; then
    echo "Warning: swiftc not found; Antinote bridge build will retry next apply." >&2
    exit 1
fi
if [[ ! -f "$SOURCE_FILE" ]]; then
    echo "Warning: Antinote bridge source is missing at $SOURCE_FILE; build will retry next apply." >&2
    exit 1
fi

mkdir -p "$INSTALL_DIR" "$STATE_DIR"
build_dir="$(mktemp -d "${TMPDIR:-/tmp}/antinote-bridge.XXXXXX")"
trap 'rm -rf "$build_dir"' EXIT
mkdir -p "$build_dir/module-cache"

SWIFT_MODULECACHE_PATH="$build_dir/module-cache" swiftc \
    -O \
    -framework Foundation \
    -framework AppKit \
    -framework CryptoKit \
    -lsqlite3 \
    -module-cache-path "$build_dir/module-cache" \
    "$SOURCE_FILE" \
    -o "$build_dir/antinote"

chmod 0755 "$build_dir/antinote"
mv "$build_dir/antinote" "$INSTALL_PATH"
printf '%s\n' "$SOURCE_FINGERPRINT" >"$MARKER"
{{- end }}
