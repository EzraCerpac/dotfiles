#!/usr/bin/env bash

# Shared helpers for explicit tasks. Keep commands rooted in the setup checkout
# and preserve the selected mise environment in nested tool invocations.
common_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
setup_root="$(cd -- "${common_dir}/../.." && pwd -P)"
# shellcheck source=../lib/setup-common.sh
source "${setup_root}/setup-scripts/lib/setup-common.sh"
SETUP_ROOT=""
setup_init || return $?

mise_exec() {
    setup_mise exec -- "$@"
}

require_setup_profile() {
    local expected="${1:?expected profile required}"
    [[ "$SETUP_PROFILE" == "$expected" ]] || {
        setup_error "this task requires profile '$expected' (selected: '$SETUP_PROFILE')"
        return 1
    }
}

require_macos() {
    [[ "$(uname -s)" == Darwin ]] || {
        setup_error "this task requires macOS"
        return 1
    }
}

require_file() {
    local path="${1:?path required}"
    [[ -f "$path" ]] || {
        echo "required file not found: $path" >&2
        return 1
    }
}

require_executable() {
    local path="${1:?path required}"
    [[ -x "$path" ]] || {
        echo "required executable not found: $path" >&2
        return 1
    }
}
