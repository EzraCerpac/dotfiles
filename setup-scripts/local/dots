#!/usr/bin/env bash
# Follow the configuration's pin even before mise installs the declared tools.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
mise_bin="${DOTS_MISE_BIN:-$HOME/.local/bin/mise}"
[[ -x "$mise_bin" ]] || mise_bin=mise
exec "$mise_bin" -C "$root" x github:EzraCerpac/dots -- dots "$@"
