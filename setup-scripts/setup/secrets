#!/usr/bin/env bash
# MISE description="Decrypt and atomically install the narrowly enrolled age secrets"
set -euo pipefail
umask 077

source "$(dirname "$0")/../lib/setup-common.sh"
setup_init || exit $?

reconcile_wakatime=0
reconcile_himalaya=0
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --reconcile)
            [[ "$#" -ge 2 ]] || { setup_error "--reconcile needs wakatime.cfg or himalaya-config.toml"; exit 2; }
            case "$2" in
                wakatime.cfg) reconcile_wakatime=1 ;;
                himalaya-config.toml) reconcile_himalaya=1 ;;
                *) setup_error "unknown secret reconciliation target: $2"; exit 2 ;;
            esac
            shift 2
            ;;
        *) setup_error "unknown argument: $1"; exit 2 ;;
    esac
done

if [[ "$SETUP_PROFILE" != "workstation" ]]; then
    printf 'No enrolled app secrets for profile %s.\n' "$SETUP_PROFILE"
    exit 0
fi

identity="${SETUP_AGE_IDENTITY:-${HOME:?HOME must be set}/.config/age/keys.txt}"
if [[ ! -r "$identity" ]]; then
    setup_error "age identity is not readable: $identity"
    exit 1
fi

wakatime_source="$SETUP_ROOT/encrypted/wakatime.cfg.age"
himalaya_source="$SETUP_ROOT/encrypted/himalaya-config.toml.age"
[[ -r "$wakatime_source" ]] || { setup_error "missing encrypted input: $wakatime_source"; exit 1; }
[[ -r "$himalaya_source" ]] || { setup_error "missing encrypted input: $himalaya_source"; exit 1; }

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mise-secrets.XXXXXX")"
staged_files=()
cleanup() {
    local staged
    if ((${#staged_files[@]})); then
        for staged in "${staged_files[@]}"; do
            [[ -e "$staged" ]] && rm -f "$staged"
        done
    fi
    rm -rf "$tmp_dir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

wakatime_plain="$tmp_dir/wakatime.cfg"
himalaya_plain="$tmp_dir/himalaya-config.toml"
setup_mise exec -- age -d -i "$identity" -o "$wakatime_plain" "$wakatime_source"
setup_mise exec -- age -d -i "$identity" -o "$himalaya_plain" "$himalaya_source"
chmod 600 "$wakatime_plain" "$himalaya_plain"

if ! awk '
    /^[[:space:]]*([#;].*)?$/ { next }
    /^[[:space:]]*\[[^]]+\][[:space:]]*([#;].*)?$/ { sections++; next }
    /^[[:space:]]*[A-Za-z0-9_.-]+[[:space:]]*=[[:space:]]*.*$/ { keys++; next }
    { invalid=1 }
    END { exit (invalid || keys == 0) }
' "$wakatime_plain"; then
    setup_error "decrypted WakaTime file is not valid INI-style settings"
    exit 1
fi

if ! setup_mise exec -- python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text())' "$himalaya_plain" >/dev/null; then
    setup_error "decrypted Himalaya file is not valid TOML (ensure the workstation Python tool is installed)"
    exit 1
fi

check_private() {
    local destination="$1" source="$2" key="$3" reconcile="$4" parent
    parent="$(dirname "$destination")"
    while [[ "$parent" != "$HOME" && "$parent" != / ]]; do
        if [[ -L "$parent" ]]; then
            setup_error "$parent is a symlink; resolve its owner before installing this secret"
            return 1
        fi
        parent="$(dirname "$parent")"
    done
    if [[ -L "$destination" ]]; then
        setup_error "$destination is a symlink; resolve its owner before installing this secret"
        return 1
    fi
    if [[ -e "$destination" && ! -f "$destination" ]]; then
        setup_error "$destination is not a regular file; refusing to install this secret"
        return 1
    fi
    if [[ -e "$destination" ]] && ! cmp -s "$source" "$destination" && [[ "$reconcile" -ne 1 ]]; then
        setup_error "$destination differs from the encrypted source; rerun with --reconcile $key after reviewing the live file"
        return 1
    fi
}

install_private() {
    local key="$1" source="$2" destination="$3" reconcile="$4" directory staged
    directory="$(dirname "$destination")"

    if [[ -e "$destination" ]]; then
        if cmp -s "$source" "$destination"; then
            chmod 600 "$destination"
            printf 'Unchanged content, private permissions enforced: %s\n' "$destination"
            return 0
        fi
    fi

    mkdir -p "$directory"
    staged="$(mktemp "$directory/.${key}.XXXXXX")" || return 1
    staged_files+=("$staged")
    chmod 600 "$source"
    cp "$source" "$staged"
    chmod 600 "$staged"
    mv -f "$staged" "$destination"
    printf 'Installed privately: %s\n' "$destination"
}

check_private "$HOME/.wakatime.cfg" "$wakatime_plain" wakatime.cfg "$reconcile_wakatime"
check_private "$HOME/.config/himalaya/config.toml" "$himalaya_plain" himalaya-config.toml "$reconcile_himalaya"
install_private wakatime.cfg "$wakatime_plain" "$HOME/.wakatime.cfg" "$reconcile_wakatime"
install_private himalaya-config.toml "$himalaya_plain" "$HOME/.config/himalaya/config.toml" "$reconcile_himalaya"

if [[ -r "$SETUP_ROOT/encrypted/jev-api-key.age" ]]; then
    bash "$SETUP_ROOT/setup-scripts/setup/jev-secret" restore
fi
