#!/usr/bin/env bash
# MISE description="Save or restore the private Jev key using age"
set -euo pipefail
umask 077
source "$(dirname "$0")/../lib/setup-common.sh"
setup_init
[[ "$SETUP_PROFILE" == workstation ]] || exit 0
identity="${SETUP_AGE_IDENTITY:-$HOME/.config/age/keys.txt}"
case "$identity" in '~/'*) identity="$HOME/${identity#\~/}" ;; esac
[[ -r "$identity" ]] || { setup_error 'Age identity is not readable'; exit 1; }
directory="$HOME/.config/jev"
destination="$directory/api-key"
encrypted="$SETUP_ROOT/encrypted/jev-api-key.age"
[[ ! -L "$directory" && ! -L "$destination" ]] || { setup_error 'Jev credential paths must not be symlinks'; exit 1; }
mkdir -p "$directory"
chmod 700 "$directory"
staged="$(mktemp "$directory/.api-key.XXXXXX")"
verified="$(mktemp "$directory/.verified.XXXXXX")"
trap 'rm -f "$staged" "$verified"' EXIT
case "${1:-restore}" in
    save)
        [[ ! -e "$encrypted" && ! -e "$destination" ]] || { setup_error 'Jev key already exists; refusing to overwrite'; exit 1; }
        IFS= read -r -s -p 'Jev API key: ' key
        printf '\n' >&2
        [[ "$key" =~ ^apikey_[[:alnum:]]+_[[:alnum:]]+$ ]] || { setup_error 'Unexpected Jev key format'; exit 1; }
        printf '%s\n' "$key" > "$staged"
        unset key
        recipient="$(setup_mise exec -- age-keygen -y "$identity")"
        setup_mise exec -- age -r "$recipient" -o "$encrypted" "$staged"
        setup_mise exec -- age -d -i "$identity" -o "$verified" "$encrypted"
        cmp -s "$staged" "$verified" || { setup_error 'Encrypted Jev key did not round-trip'; exit 1; }
        ;;
    restore)
        setup_mise exec -- age -d -i "$identity" -o "$staged" "$encrypted"
        if [[ -e "$destination" ]] && ! cmp -s "$staged" "$destination"; then
            setup_error 'Local Jev key differs from encrypted source; preserving it'
            exit 1
        fi
        ;;
    *) setup_error 'usage: jev-secret [save|restore]'; exit 2 ;;
esac
chmod 600 "$staged"
mv -f "$staged" "$destination"
echo 'Jev key stored privately.'
