#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
data_home="${XDG_DATA_HOME:-${HOME:?HOME must be set}/.local/share}"
app_name="${NVIM_APPNAME:-nvim}"
lazy_root="$data_home/$app_name/lazy"
lazy_path="$lazy_root/lazy.nvim"
if [[ ! -e "$lazy_path" ]]; then
    mkdir -p "$lazy_root"
    temporary="$(mktemp -d "$lazy_root/.lazy-bootstrap.XXXXXX")"
    trap 'rm -rf -- "$temporary"' EXIT
    git clone --filter=blob:none --branch=stable https://github.com/folke/lazy.nvim.git "$temporary/lazy.nvim"
    if [[ ! -e "$lazy_path" ]]; then
        mv "$temporary/lazy.nvim" "$lazy_path"
    fi
fi
if [[ ! -f "$lazy_path/lua/lazy/init.lua" ]]; then
    printf 'Neovim initialization: incomplete lazy.nvim checkout at %s; inspect it before retrying.\n' "$lazy_path" >&2
    exit 1
fi
export SETUP_NVIM_INITIALIZE_SCRIPT="$script_dir/nvim-initialize.lua"
nvim --headless \
    --cmd 'lua vim.opt.rtp:prepend(vim.fn.stdpath("data") .. "/lazy/lazy.nvim"); require("lazy.core.config").defaults.install.missing = false' \
    -c 'lua dofile(vim.env.SETUP_NVIM_INITIALIZE_SCRIPT)' -c qa

export SETUP_NVIM_READY_SCRIPT="$script_dir/nvim-ready.lua"
nvim --headless \
    --cmd 'lua vim.opt.rtp:prepend(vim.fn.stdpath("data") .. "/lazy/lazy.nvim"); require("lazy.core.config").defaults.install.missing = false' \
    -c 'lua dofile(vim.env.SETUP_NVIM_READY_SCRIPT)' -c qa
