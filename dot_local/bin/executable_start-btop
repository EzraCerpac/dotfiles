#!/usr/bin/env bash
set -euo pipefail

RIFT_CLI=${RIFT_CLI:-/opt/homebrew/bin/rift-cli}
BTOP=${BTOP:-/opt/homebrew/bin/btop}
OPEN_BIN=${OPEN_BIN:-/usr/bin/open}
WEZTERM_APP=${WEZTERM_APP:-/Applications/WezTerm.app}
JQ=${JQ:-jq}
LOCKF=${LOCKF:-/usr/bin/lockf}
LOCK_PATH=${START_BTOP_LOCK_PATH:-${TMPDIR:-/tmp}/start-btop.lock}
TIMER_STATE=${START_BTOP_TIMER_STATE:-${TMPDIR:-/tmp}/start-btop.timer}
CLOSE_AFTER=${START_BTOP_CLOSE_AFTER:-60}
OPS_WORKSPACE=${START_BTOP_WORKSPACE:-9}

focus_workspace=false
case "${1:-}" in
    "") ;;
    --focus) focus_workspace=true ;;
    --expire)
        [[ $# -eq 5 ]] || exit 2
        ;;
    *)
        echo "usage: start-btop [--focus]" >&2
        exit 2
        ;;
esac

if [[ ${START_BTOP_LOCKED:-0} != 1 ]]; then
    exec "$LOCKF" -k "$LOCK_PATH" /usr/bin/env \
        START_BTOP_LOCKED=1 \
        RIFT_CLI="$RIFT_CLI" \
        START_BTOP_LOCK_PATH="$LOCK_PATH" \
        START_BTOP_TIMER_STATE="$TIMER_STATE" \
        START_BTOP_CLOSE_AFTER="$CLOSE_AFTER" \
        START_BTOP_WORKSPACE="$OPS_WORKSPACE" \
        /bin/bash "$0" "$@"
fi

displays_json=

load_displays() {
    displays_json=$("$RIFT_CLI" query displays)
}

active_display_uuid() {
    "$JQ" -er '
        [ .[] | select(.is_active_context == true and .space != null) | .uuid ]
        | if length == 1 then .[0] else error("active Rift display is ambiguous") end
    ' <<<"$displays_json"
}

active_space_id() {
    "$JQ" -er '
        [ .[] | select(.is_active_context == true and .space != null) | .space ]
        | if length == 1 then .[0] else error("active Rift display space is ambiguous") end
    ' <<<"$displays_json"
}

preferred_display_uuid() {
    "$JQ" -er '
        def is_external:
            if has("is_builtin") then
                .is_builtin == false
            elif ((.name // "") | test("built-in"; "i")) then
                false
            else
                (.screen_id // 1) != 1
            end;
        [ .[]
          | select(.space != null and is_external)
          | {uuid, x: (.frame.origin.x // 0), y: (.frame.origin.y // 0)}
        ]
        | if length == 0 then empty
          else sort_by([.x, .y]) | last.uuid
          end
    ' <<<"$displays_json"
}

target_display_uuid() {
    local active_uuid=$1
    if $focus_workspace; then
        preferred_display_uuid || printf '%s\n' "$active_uuid"
    else
        printf '%s\n' "$active_uuid"
    fi
}

focus_display() {
    local display_uuid=$1
    "$RIFT_CLI" execute display focus --uuid "$display_uuid" >/dev/null
}

active_workspace_index() {
    local space_id=$1
    "$RIFT_CLI" query workspaces --space-id "$space_id" \
        | "$JQ" -er '
            [ .[] | select(.is_active == true) | .index ]
            | if length == 1 then .[0] else error("active Rift workspace is ambiguous") end
        '
}

find_btop_window() {
    local display_uuid
    local space_id
    local records
    while IFS=$'\t' read -r display_uuid space_id; do
        [[ -n "$display_uuid" && -n "$space_id" ]] || continue
        records=$("$RIFT_CLI" query workspaces --space-id "$space_id" \
            | "$JQ" -c --arg display_uuid "$display_uuid" '
                .[] | .windows[]?
                | select(
                    .bundle_id == "com.github.wez.wezterm"
                    or (.bundle_id == null and .app_name == "WezTerm")
                )
                | select((.title // "") | test("^btop([[:space:]]|$)"; "i"))
                | select(.id.pid != null and .id.idx != null)
                | { pid: .id.pid, idx: .id.idx, display_uuid: $display_uuid }
            ') || return 1
        if [[ -n "$records" ]]; then
            printf '%s\n' "${records%%$'\n'*}"
            return 0
        fi
    done < <(
        "$JQ" -r '.[] | select(.space != null and .uuid != null) | [.uuid, (.space | tostring)] | @tsv' <<<"$displays_json"
    )
    return 1
}

window_json() {
    printf '{"pid":%s,"idx":%s}' "$1" "$2"
}

btop_fill_state() {
    local expected_pid=$1
    local expected_idx=$2
    local display_uuid=$3
    local json
    local window
    json=$(window_json "$expected_pid" "$expected_idx")
    window=$("$RIFT_CLI" query window "$json") || return 1

    "$JQ" -er \
        --arg display_uuid "$display_uuid" \
        --argjson expected_pid "$expected_pid" \
        --argjson expected_idx "$expected_idx" \
        --argjson window "$window" '
            [ .[] | select(.uuid == $display_uuid and .frame.size != null) ]
            | if length == 1 then .[0].frame.size else error("target display is ambiguous") end
            | . as $display
            | select(
                $window.id.pid == $expected_pid
                and $window.id.idx == $expected_idx
                and $window.frame.size != null
                and (
                    $window.bundle_id == "com.github.wez.wezterm"
                    or ($window.bundle_id == null and $window.app_name == "WezTerm")
                )
                and (($window.title // "") | test("^btop([[:space:]]|$)"; "i"))
            )
            | if (
                $window.frame.size.width >= ($display.width * 0.95)
                and $window.frame.size.height >= ($display.height * 0.95)
              ) then "full" else "narrow" end
        ' <<<"$displays_json"
}

ensure_btop_fullscreen() {
    local pid=$1
    local idx=$2
    local display_uuid=$3
    local fill_state=
    local json
    json=$(window_json "$pid" "$idx")

    "$RIFT_CLI" execute window focus --window-id "$json"
    fill_state=$(btop_fill_state "$pid" "$idx" "$display_uuid") || fill_state=
    if [[ $fill_state == narrow ]]; then
        "$RIFT_CLI" execute window toggle-fullscreen-within-gaps
    fi
}

is_btop_window() {
    local expected_pid=$1
    local expected_idx=$2
    local expected_window_server_id=$3
    local json
    json=$(window_json "$expected_pid" "$expected_idx")

    "$RIFT_CLI" query window "$json" \
        | "$JQ" -e \
            --argjson expected_pid "$expected_pid" \
            --argjson expected_idx "$expected_idx" \
            --argjson expected_window_server_id "$expected_window_server_id" '
                .id.pid == $expected_pid
                and .id.idx == $expected_idx
                and .window_server_id == $expected_window_server_id
                and (
                    .bundle_id == "com.github.wez.wezterm"
                    or (.bundle_id == null and .app_name == "WezTerm")
                )
                and ((.title // "") | test("^btop([[:space:]]|$)"; "i"))
            ' >/dev/null
}

fresh_btop_window_server_id() {
    local expected_pid=$1
    local expected_idx=$2
    local json
    json=$(window_json "$expected_pid" "$expected_idx")

    "$RIFT_CLI" query window "$json" \
        | "$JQ" -er \
            --argjson expected_pid "$expected_pid" \
            --argjson expected_idx "$expected_idx" '
                select(
                    .id.pid == $expected_pid
                    and .id.idx == $expected_idx
                    and .window_server_id != null
                    and (
                        .bundle_id == "com.github.wez.wezterm"
                        or (.bundle_id == null and .app_name == "WezTerm")
                    )
                    and ((.title // "") | test("^btop([[:space:]]|$)"; "i"))
                )
                | .window_server_id
            '
}

schedule_close_if_safe() {
    local pid=$1
    local idx=$2
    local window_server_id=

    # Reusing and focusing only needs Rift's stable {pid, idx}. Closing is more
    # dangerous, so require a freshly queried WindowServer identity.
    window_server_id=$(fresh_btop_window_server_id "$pid" "$idx") || window_server_id=
    if [[ -n "$window_server_id" ]]; then
        schedule_close "$pid" "$idx" "$window_server_id"
    else
        rm -f "$TIMER_STATE"
    fi
}

btop_workspace_activity() {
    local expected_pid=$1
    local expected_idx=$2
    local expected_window_server_id=$3
    local display_uuid
    local space_id
    local activity=
    local matches=0
    local workspace_activity

    load_displays || return 1
    while IFS=$'\t' read -r display_uuid space_id; do
        [[ -n "$display_uuid" && -n "$space_id" ]] || continue
        workspace_activity=$(
            "$RIFT_CLI" query workspaces --space-id "$space_id" \
                | "$JQ" -r \
                    --argjson expected_pid "$expected_pid" \
                    --argjson expected_idx "$expected_idx" \
                    --argjson expected_window_server_id "$expected_window_server_id" \
                    --argjson ops_workspace "$OPS_WORKSPACE" '
                        .[]
                        | select(.index == $ops_workspace)
                        | select(any(.windows[]?;
                            .id.pid == $expected_pid
                            and .id.idx == $expected_idx
                            and .window_server_id == $expected_window_server_id
                        ))
                        | if .is_active == true then "active" else "inactive" end
                    '
        ) || return 1
        if [[ -n "$workspace_activity" ]]; then
            activity=$workspace_activity
            matches=$((matches + 1))
        fi
    done < <(
        "$JQ" -r '.[] | select(.space != null and .uuid != null) | [.uuid, (.space | tostring)] | @tsv' <<<"$displays_json"
    )

    [[ $matches -eq 1 ]] || return 1
    printf '%s\n' "$activity"
}

expire_btop_window() {
    local expected_pid=$1
    local expected_idx=$2
    local expected_window_server_id=$3
    local expected_generation=$4
    local scheduled_pid=
    local scheduled_idx=
    local scheduled_window_server_id=
    local scheduled_generation=
    local workspace_activity=

    [[ -f "$TIMER_STATE" ]] || exit 0
    IFS=$'\t' read -r scheduled_pid scheduled_idx scheduled_window_server_id scheduled_generation < "$TIMER_STATE" || exit 0
    [[ $scheduled_pid == "$expected_pid" \
        && $scheduled_idx == "$expected_idx" \
        && $scheduled_window_server_id == "$expected_window_server_id" \
        && $scheduled_generation == "$expected_generation" ]] || exit 0

    # A missing/restarted Rift instance, changed title, ambiguous workspace, or
    # changed identity is deliberately a no-op. Never close an uncertain window.
    if ! is_btop_window "$expected_pid" "$expected_idx" "$expected_window_server_id"; then
        rm -f "$TIMER_STATE"
        return
    fi
    workspace_activity=$(
        btop_workspace_activity "$expected_pid" "$expected_idx" "$expected_window_server_id"
    ) || workspace_activity=
    if [[ $workspace_activity == active ]]; then
        schedule_close "$expected_pid" "$expected_idx" "$expected_window_server_id"
        return
    fi
    if [[ $workspace_activity == inactive ]] \
        && is_btop_window "$expected_pid" "$expected_idx" "$expected_window_server_id"; then
        "$RIFT_CLI" execute window close --window-server-id "$expected_window_server_id"
    fi
    rm -f "$TIMER_STATE"
}

schedule_close() {
    local pid=$1
    local idx=$2
    local window_server_id=$3
    local generation
    generation="$(/bin/date +%s%N)-$$-$RANDOM-$RANDOM"

    umask 077
    printf '%s\t%s\t%s\t%s\n' "$pid" "$idx" "$window_server_id" "$generation" > "$TIMER_STATE"
    (
        sleep "$CLOSE_AFTER"
        /usr/bin/env START_BTOP_LOCKED=0 \
            RIFT_CLI="$RIFT_CLI" \
            START_BTOP_LOCK_PATH="$LOCK_PATH" \
            START_BTOP_TIMER_STATE="$TIMER_STATE" \
            START_BTOP_CLOSE_AFTER="$CLOSE_AFTER" \
            START_BTOP_WORKSPACE="$OPS_WORKSPACE" \
            /bin/bash "$0" --expire "$pid" "$idx" "$window_server_id" "$generation"
    ) </dev/null >/dev/null 2>&1 &
}

if [[ ${1:-} == --expire ]]; then
    expire_btop_window "$2" "$3" "$4" "$5"
    exit 0
fi

load_displays
active_display=$(active_display_uuid)
space_id=$(active_space_id)
focused_workspace=$(active_workspace_index "$space_id")
target_display=$(target_display_uuid "$active_display")

existing_window=$(find_btop_window) || existing_window=

if [[ -n "$existing_window" ]]; then
    btop_pid=$("$JQ" -er '.pid' <<< "$existing_window")
    btop_idx=$("$JQ" -er '.idx' <<< "$existing_window")
    btop_display=$("$JQ" -er '.display_uuid' <<< "$existing_window")
    if [[ "$btop_display" != "$target_display" ]]; then
        "$RIFT_CLI" execute display move-window \
            --uuid "$target_display" --window-id "$btop_idx"
    fi
    if $focus_workspace; then
        if [[ "$target_display" != "$active_display" ]]; then
            focus_display "$target_display"
        fi
        "$RIFT_CLI" execute workspace move-window "$OPS_WORKSPACE" "$btop_idx"
        "$RIFT_CLI" execute workspace switch "$OPS_WORKSPACE"
        ensure_btop_fullscreen "$btop_pid" "$btop_idx" "$target_display"
    else
        "$RIFT_CLI" execute workspace move-window "$OPS_WORKSPACE" "$btop_idx"
    fi
    schedule_close_if_safe "$btop_pid" "$btop_idx"
    exit 0
fi

if $focus_workspace && [[ "$target_display" != "$active_display" ]]; then
    focus_display "$target_display"
fi
"$OPEN_BIN" -na "$WEZTERM_APP" --args start -- "$BTOP"

# WezTerm publishes its title after launch; poll Rift until the managed window
# appears in one of the managed native spaces.
window_record=
for _ in {1..200}; do
    if window_record=$(find_btop_window) && [[ -n "$window_record" ]]; then
        break
    fi
    window_record=
    sleep 0.1
done

if [[ -z "$window_record" ]]; then
    echo "start-btop: Rift WezTerm window not detected" >&2
    exit 1
fi

btop_pid=$("$JQ" -er '.pid' <<< "$window_record")
btop_idx=$("$JQ" -er '.idx' <<< "$window_record")
if $focus_workspace; then
    "$RIFT_CLI" execute workspace move-window "$OPS_WORKSPACE" --follow "$btop_idx"
    ensure_btop_fullscreen "$btop_pid" "$btop_idx" "$target_display"
else
    "$RIFT_CLI" execute workspace move-window "$OPS_WORKSPACE" "$btop_idx"
    "$RIFT_CLI" execute workspace switch "$focused_workspace"
fi
schedule_close_if_safe "$btop_pid" "$btop_idx"
