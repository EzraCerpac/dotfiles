#!/usr/bin/env bash
set -euo pipefail

remctl_python="$HOME/.local/share/mise/installs/python/3.13/bin/python3"
remctl_cli="$HOME/.local/libexec/remctl/remctl"

if [[ ! -x "$remctl_python" ]]; then
    echo "remctl requires the Mise Python 3.13 runtime at $remctl_python" >&2
    exit 1
fi

if [[ ! -x "$remctl_cli" ]]; then
    echo "remctl is not installed at $remctl_cli" >&2
    exit 1
fi

exec "$remctl_python" "$remctl_cli" "$@"
