#!/usr/bin/env bash

set -euo pipefail

readonly RIFT_CONFIGURED_IDENTITY="{{ with (index .packages.darwin.managed_apps "rift") }}{{ .signing_identity }}{{ end }}"
RIFT_IDENTITY_NAME="$RIFT_CONFIGURED_IDENTITY"
if [[ "${RIFT_SETUP_TESTING:-0}" == 1 ]]; then
    RIFT_IDENTITY_NAME="${RIFT_TEST_SIGNING_IDENTITY_NAME:-$RIFT_IDENTITY_NAME}"
fi
readonly RIFT_IDENTITY_NAME
readonly SECURITY_BIN="${RIFT_SECURITY_BIN:-/usr/bin/security}"
readonly CODESIGN_BIN="${RIFT_CODESIGN_BIN:-/usr/bin/codesign}"
readonly PROBE_IDENTIFIER="${RIFT_PROBE_IDENTIFIER:-git.acsandmann.rift.signing-probe}"

die() {
    echo "rift-local-signing-setup: $*" >&2
    exit 1
}

require_command() {
    local command_name="${1:?command required}"
    command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
}

find_identity() {
    local output=""
    local hash=""
    local matches=0

    output="$("$SECURITY_BIN" find-identity -v -p codesigning 2>/dev/null)" ||
        die "could not inspect code-signing identities"
    while IFS=$'\t' read -r candidate_hash candidate_name; do
        [[ -n "$candidate_hash" ]] || continue
        if [[ "$candidate_name" == "$RIFT_IDENTITY_NAME" ]]; then
            hash="$candidate_hash"
            matches=$((matches + 1))
        fi
    done < <(
        printf '%s\n' "$output" |
            sed -nE 's/^[[:space:]]*[0-9]+\)[[:space:]]+([[:xdigit:]]{40})[[:space:]]+"([^"]+)"[[:space:]]*$/\1\t\2/p'
    )

    [[ "$matches" -eq 1 ]] ||
        die "expected exactly one '$RIFT_IDENTITY_NAME' identity; found $matches"
    [[ "$hash" =~ ^[[:xdigit:]]{40}$ ]] || die "Keychain returned an invalid identity hash"
    printf '%s\n' "$hash"
}

read_designated_requirement() {
    local code_path="${1:?code path required}"
    local output=""
    local requirement=""

    output="$("$CODESIGN_BIN" -d -r- "$code_path" 2>&1)" || return 1
    requirement="$(printf '%s\n' "$output" |
        sed -n 's/^[[:space:]]*designated =>/designated =>/p' | head -n 1)"
    [[ -n "$requirement" ]] || return 1
    printf '%s\n' "$requirement"
}

validate_requirement() {
    local code_path="${1:?code path required}"
    local requirement=""
    local trust_output="" details="" authority="" identifier=""

    requirement="$(read_designated_requirement "$code_path")" ||
        die "the signing probe has no designated requirement"
    if [[ "$(printf '%s' "$requirement" | tr '[:upper:]' '[:lower:]')" == *cdhash* ]]; then
        die "the signing probe has a CDHash-only designated requirement"
    fi
    if ! trust_output="$("$CODESIGN_BIN" -v "-R=${requirement#designated => }" "$code_path" 2>&1)"; then
        [[ -z "$trust_output" ]] || echo "$trust_output" >&2
        die "the '$RIFT_IDENTITY_NAME' certificate is not trusted for code signing"
    fi
    details="$("$CODESIGN_BIN" --display --verbose=4 "$code_path" 2>&1)" ||
        die "could not inspect the signing probe metadata"
    authority="$(printf '%s\n' "$details" | awk -F= '$1 == "Authority" { print substr($0, 11); exit }')"
    identifier="$(printf '%s\n' "$details" | awk -F= '$1 == "Identifier" { print substr($0, 12); exit }')"
    [[ "$authority" == "$RIFT_IDENTITY_NAME" ]] || die "the signing probe has the wrong Authority metadata"
    [[ "$identifier" == "$PROBE_IDENTIFIER" ]] || die "the signing probe has the wrong Identifier metadata"
}

require_command "$SECURITY_BIN"
require_command "$CODESIGN_BIN"

cat <<EOF
Rift needs one stable local signing identity.

The private key stays in your login keychain. This helper never exports or records it.
If the identity already exists, leave it in place and continue.

1. Open Keychain Access.
2. Choose Certificate Assistant -> Create a Certificate.
3. Name it: $RIFT_IDENTITY_NAME
4. Choose Self Signed Root and Code Signing.
5. Set a long validity period and save it in the login keychain.
6. Open its Trust section and set Code Signing (or the certificate) to Always Trust.
EOF

if [[ "${RIFT_SETUP_SKIP_PAUSE:-0}" != 1 ]]; then
    printf 'Press Enter after the certificate is ready: '
    read -r _ || true
fi

identity_hash="$(find_identity)"
probe="$(mktemp "${TMPDIR:-/tmp}/rift-signing-probe.XXXXXX")"
cleanup_probe() {
    rm -f "$probe"
}
trap cleanup_probe EXIT

cp /usr/bin/true "$probe" || die "could not create the temporary signing probe"
"$CODESIGN_BIN" --force --sign "$identity_hash" --identifier "$PROBE_IDENTIFIER" --timestamp=none "$probe" >/dev/null 2>&1 ||
    die "could not sign the temporary probe"
"$CODESIGN_BIN" --verify --strict --verbose=2 "$probe" >/dev/null 2>&1 ||
    die "the temporary probe signature could not be verified"
validate_requirement "$probe"

echo "Validated $RIFT_IDENTITY_NAME ($identity_hash)."
echo "The Rift installer will sign rift and rift-cli by identity hash; it never falls back to ad-hoc signing."
