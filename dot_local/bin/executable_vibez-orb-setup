#!/usr/bin/env bash
set -euo pipefail

machine="${VIBEZ_ORB_MACHINE:-vibez}"
repair_cache=0
upgrade=0

usage() {
    cat <<'EOF'
usage: vibez-orb-setup [--repair-cache] [--upgrade]

Creates/repairs the amd64 OrbStack machine used by vibez.

  --repair-cache  remove cached Chromium so vibez redownloads it next launch
  --upgrade       rerun upstream vibez installer even if vibez is present
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --repair-cache) repair_cache=1 ;;
        --upgrade) upgrade=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "vibez-orb-setup: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if ! command -v orbctl >/dev/null 2>&1; then
    echo "vibez-orb-setup: orbctl not found; install or start OrbStack first" >&2
    exit 127
fi

if ! orbctl info "$machine" >/dev/null 2>&1; then
    orbctl create -a amd64 ubuntu "$machine"
fi

orbctl run -m "$machine" sudo apt-get update
orbctl run -m "$machine" sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl tar xz-utils grep sed \
    dbus-user-session dbus-x11 xdg-utils desktop-file-utils libnotify-bin \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2t64 libpulse0 \
    libgtk-3-0 libwebkit2gtk-4.1-0 \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-libav fonts-liberation

if [ "$upgrade" -eq 1 ] || ! orbctl run -m "$machine" sh -lc 'test -x "$HOME/.local/bin/vibez"' >/dev/null 2>&1; then
    orbctl run -m "$machine" sh -lc 'curl --proto "=https" --tlsv1.2 -sSf https://raw.githubusercontent.com/simonepelosi/vibez/main/scripts/install.sh | sh'
fi

if [ "$repair_cache" -eq 1 ]; then
    orbctl run -m "$machine" sh -lc 'rm -rf "$HOME/.cache/vibez/chrome"'
fi

echo "vibez OrbStack machine '$machine' ready."
