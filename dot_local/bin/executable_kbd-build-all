#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/kbd-common.sh"

"$(resolve_kbd_script kbd-build "${SCRIPT_DIR}")" --convert-to rp2040_ce
"$(resolve_kbd_script kbd-build "${SCRIPT_DIR}")" --convert-to sparkfun_pm2040

echo "all firmware targets built"
