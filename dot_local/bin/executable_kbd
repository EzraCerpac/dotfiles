#!/usr/bin/env bash
set -euo pipefail

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"

readonly CONFIG_DIR="${HOME}/.config/keyboard/corne-qmk"
readonly KEYMAP_NAME="ezra_corne"
readonly KEYBOARD="crkbd/rev1"
readonly KEYMAP_DIR="${CONFIG_DIR}/keymaps/${KEYMAP_NAME}"
readonly KEYMAP_C="${KEYMAP_DIR}/keymap.c"
readonly KEYMAP_CFG="${CONFIG_DIR}/keymap-drawer.yaml"
readonly IMAGE_DIR="${CONFIG_DIR}/images/generated"
readonly QMK_DIR="${HOME}/Projects/keyboards/qmk_firmware"
readonly LEGACY_QMK_DIR="${HOME}/Projects/keyboards/vial-qmk"
readonly QMK_KEYMAP_DIR="${QMK_DIR}/keyboards/crkbd/keymaps/${KEYMAP_NAME}"
readonly ARTIFACT_DIR="${HOME}/Projects/keyboards/artifacts/corne-rev1"
readonly ARM_TOOLCHAIN_PATH="/opt/homebrew/opt/arm-none-eabi-gcc@9/bin:/opt/homebrew/opt/arm-none-eabi-binutils/bin"

QMK_RUNNER=()
QMK_RUNNER_MODE=""
QMK_RUNNER_WORKDIR=""

usage() {
    cat <<'EOF'
usage: kbd <command> [args]

commands:
  provision
  doctor
  sync
  build [--convert-to target] [--left|--right]
  build-all
  flash <left|right> [--convert-to target] [-n|--dry-run]
  layout-images
  hud-reload
  open-artifacts
EOF
}

DOCTOR_FAILURES=0

require_value() {
    local flag="${1:?flag required}"
    local value="${2:-}"

    if [[ -z "${value}" ]]; then
        echo "${flag} requires a value" >&2
        exit 1
    fi
}

qmk_env_path() {
    export PATH="${ARM_TOOLCHAIN_PATH}:${PATH}"
}

resolve_qmk_runner() {
    if [[ -n "${QMK_RUNNER_MODE}" ]]; then
        return 0
    fi

    local qmk_home="${QMK_HOME:-${QMK_DIR}}"
    local candidate=""
    local lib_root=""
    local py_name=""
    local prefix=""
    local python_bin=""
    local -a site_packages=(
        /opt/homebrew/Cellar/qmk/*/libexec/lib/python*/site-packages
        /usr/local/Cellar/qmk/*/libexec/lib/python*/site-packages
    )

    if [[ -d "${qmk_home}/lib/python/qmk/cli" ]]; then
        for candidate in "${site_packages[@]}"; do
            [[ -d "${candidate}" ]] || continue

            lib_root="${candidate%/site-packages}"
            py_name="$(basename "${lib_root}")"
            prefix="${lib_root%/lib/*}"
            python_bin="${prefix}/bin/${py_name}"

            if [[ -x "${python_bin}" ]] && (
                cd "${qmk_home}" &&
                    env ORIG_CWD="${qmk_home}" \
                        PYTHONPATH="${qmk_home}/lib/python:${candidate}${PYTHONPATH:+:${PYTHONPATH}}" \
                        "${python_bin}" -c 'import sys; from qmk.cli import cli; sys.argv[0] = "qmk"; cli()' --help >/dev/null 2>&1
            ); then
                QMK_RUNNER_MODE="local_qmk_home"
                QMK_RUNNER_WORKDIR="${qmk_home}"
                QMK_RUNNER=(
                    env
                    "ORIG_CWD=${qmk_home}"
                    "PYTHONPATH=${qmk_home}/lib/python:${candidate}${PYTHONPATH:+:${PYTHONPATH}}"
                    "${python_bin}"
                    -c
                    'import sys; from qmk.cli import cli; sys.argv[0] = "qmk"; cli()'
                )
                return 0
            fi
        done
    fi

    if command -v qmk >/dev/null 2>&1 && qmk --version >/dev/null 2>&1; then
        QMK_RUNNER_MODE="system_qmk"
        QMK_RUNNER=(qmk)
        return 0
    fi

    for candidate in "${site_packages[@]}"; do
        if [[ -d "${candidate}/qmk_cli" ]] && python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from qmk_cli.script_qmk import main' "${candidate}" >/dev/null 2>&1; then
            QMK_RUNNER_MODE="wrapper_qmk"
            QMK_RUNNER=(env "PYTHONPATH=${candidate}${PYTHONPATH:+:${PYTHONPATH}}" python3 -m qmk_cli.script_qmk)
            return 0
        fi
    done

    echo "qmk CLI is unavailable. Run chezmoi apply, then rerun: kbd provision" >&2
    return 1
}

run_qmk() {
    resolve_qmk_runner
    if [[ "${QMK_RUNNER_MODE}" == "local_qmk_home" ]]; then
        (
            cd "${QMK_RUNNER_WORKDIR}"
            "${QMK_RUNNER[@]}" "$@"
        )
        return
    fi

    "${QMK_RUNNER[@]}" "$@"
}

require_qmk_checkout() {
    if [[ ! -d "${QMK_DIR}" ]]; then
        echo "missing qmk_firmware checkout: ${QMK_DIR}" >&2
        echo "run: kbd provision" >&2
        exit 1
    fi
}

cmd_provision_prerequisites() {
    local missing=0
    local command_name
    local -a required_commands=(git uv qmk kanata dos2unix rsvg-convert avr-gcc arm-none-eabi-gcc keymap)

    for command_name in "${required_commands[@]}"; do
        if ! command -v "${command_name}" >/dev/null 2>&1; then
            echo "missing keyboard prerequisite: ${command_name}" >&2
            missing=1
        fi
    done
    if ! virtualhid_components_exist; then
        echo "missing keyboard prerequisite: Karabiner VirtualHID components" >&2
        missing=1
    fi
    if [[ "${missing}" == "1" ]]; then
        echo "Run: chezmoi apply" >&2
        echo "Then rerun: kbd provision" >&2
        return 1
    fi
}

cmd_provision_qmk() {
    mkdir -p "${HOME}/Projects/keyboards"
    if [[ -d "${QMK_DIR}" ]] && [[ ! -d "${QMK_DIR}/.git" ]]; then
        mv "${QMK_DIR}" "${QMK_DIR}.incomplete.$(date +%s)" 2>/dev/null || true
    fi
    if [[ ! -d "${QMK_DIR}/.git" ]]; then
        if ! git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone --single-branch https://github.com/qmk/qmk_firmware "${QMK_DIR}"; then
            mv "${QMK_DIR}" "${QMK_DIR}.failed.$(date +%s)" 2>/dev/null || true
            if ! git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone --depth 1 --single-branch https://github.com/qmk/qmk_firmware "${QMK_DIR}"; then
                if [[ -d "${LEGACY_QMK_DIR}/.git" ]]; then
                    echo "warning: using existing ${LEGACY_QMK_DIR} as fallback for qmk_firmware" >&2
                    mv "${QMK_DIR}" "${QMK_DIR}.failed.$(date +%s)" 2>/dev/null || true
                    ln -sfn "${LEGACY_QMK_DIR}" "${QMK_DIR}"
                else
                    echo "failed to clone qmk_firmware and no local fallback found" >&2
                    exit 1
                fi
            fi
        fi
    else
        git -C "${QMK_DIR}" fetch origin
        current_branch="$(git -C "${QMK_DIR}" symbolic-ref --quiet --short HEAD || true)"
        if [[ -n "${current_branch}" ]]; then
            git -C "${QMK_DIR}" pull --ff-only origin "${current_branch}"
        else
            echo "qmk_firmware is detached; fetched origin without moving checkout"
        fi
    fi

    configure_qmk_checkout
}

configure_qmk_checkout() {
    git -C "${QMK_DIR}" submodule update --init --recursive
    if ! run_qmk config user.qmk_home="${QMK_DIR}" >/dev/null 2>&1; then
        echo "QMK config failed. Run chezmoi apply, then rerun: kbd provision" >&2
        return 1
    fi
}

readonly KARABINER_MANAGER="${KBD_KARABINER_MANAGER:-/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager}"
readonly KARABINER_DAEMON="${KBD_KARABINER_DAEMON:-/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Daemon}"
readonly KARABINER_LABEL="org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon"
readonly KARABINER_CORE_LABEL="org.pqrs.service.daemon.Karabiner-Core-Service"
readonly KARABINER_LEGACY_LABEL="org.pqrs.Karabiner-VirtualHIDDevice-Daemon.chezmoi"
readonly KARABINER_LEGACY_PLIST="${KBD_KARABINER_LEGACY_PLIST:-/Library/LaunchDaemons/${KARABINER_LEGACY_LABEL}.plist}"
readonly KARABINER_CORE_LEGACY_PLIST="${KBD_KARABINER_CORE_LEGACY_PLIST:-/Library/LaunchDaemons/${KARABINER_CORE_LABEL}.plist}"
readonly KANATA_CONFIG="${KBD_KANATA_CONFIG:-${HOME}/.config/kanata/config.kbd}"
readonly KANATA_PLIST="${KBD_KANATA_PLIST:-/Library/LaunchDaemons/com.kanata.daemon.plist}"
readonly KANATA_LABEL="com.kanata.daemon"
readonly KANATA_LEGACY_AGENT="${KBD_KANATA_LEGACY_AGENT:-${HOME}/Library/LaunchAgents/com.kanata.agent.plist}"
readonly TCC_DB="${KBD_TCC_DB:-/Library/Application Support/com.apple.TCC/TCC.db}"

driverkit_is_active() {
    systemextensionsctl list 2>/dev/null | grep -q "org.pqrs.Karabiner-DriverKit-VirtualHIDDevice.*activated enabled"
}

virtualhid_components_exist() {
    [[ -x "${KARABINER_MANAGER}" ]] && [[ -x "${KARABINER_DAEMON}" ]]
}

cmd_provision_virtualhid() {
    if ! virtualhid_components_exist; then
        echo "Karabiner VirtualHID components are missing. Open Karabiner-Elements once, then rerun: kbd provision" >&2
        return 1
    fi

    if ! driverkit_is_active; then
        echo "Activating Karabiner VirtualHID driver..."
        if ! sudo "${KARABINER_MANAGER}" activate >/dev/null 2>&1; then
            echo "Karabiner VirtualHID activation failed. Run: sudo '${KARABINER_MANAGER}' activate" >&2
            return 1
        fi
    fi
    if ! driverkit_is_active; then
        echo "Approve Karabiner DriverKit in System Settings > Privacy & Security, then rerun: kbd provision" >&2
        return 1
    fi

    if sudo launchctl print "system/${KARABINER_LEGACY_LABEL}" >/dev/null 2>&1; then
        sudo launchctl bootout "system/${KARABINER_LEGACY_LABEL}" >/dev/null 2>&1 || true
    fi
    if [[ -f "${KARABINER_LEGACY_PLIST}" ]]; then
        sudo rm -f "${KARABINER_LEGACY_PLIST}"
    fi
    if [[ -f "${KARABINER_CORE_LEGACY_PLIST}" ]]; then
        sudo rm -f "${KARABINER_CORE_LEGACY_PLIST}"
    fi

    if ! launchctl print "system/${KARABINER_LABEL}" >/dev/null 2>&1; then
        echo "Open Karabiner-Elements once so it starts VirtualHID, then rerun: kbd provision" >&2
        return 1
    fi
}

render_kanata_plist() {
    local kanata_bin="${1:?kanata binary required}"
    local output="${2:?output path required}"
    local escaped_bin
    local escaped_config

    escaped_bin="$(printf '%s' "${kanata_bin}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
    escaped_config="$(printf '%s' "${KANATA_CONFIG}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"

    cat >"${output}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${KANATA_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${escaped_bin}</string>
        <string>--cfg</string>
        <string>${escaped_config}</string>
        <string>--no-wait</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/kanata.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/kanata.err.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
EOF
}

cmd_provision_kanata() {
    local kanata_bin="${1:?kanata binary required}"
    if [[ ! -f "${KANATA_CONFIG}" ]]; then
        echo "Kanata config is missing: ${KANATA_CONFIG}. Run chezmoi apply, then rerun: kbd provision" >&2
        return 1
    fi
    if ! "${kanata_bin}" --check --cfg "${KANATA_CONFIG}" >/dev/null 2>&1; then
        echo "Kanata config check failed: ${KANATA_CONFIG}" >&2
        return 1
    fi

    if [[ -f "${KANATA_LEGACY_AGENT}" ]]; then
        launchctl bootout "gui/$(id -u)" "${KANATA_LEGACY_AGENT}" >/dev/null 2>&1 || true
        rm -f "${KANATA_LEGACY_AGENT}"
    fi

    (
        local tmp_file
        tmp_file="$(mktemp)"
        trap 'rm -f "${tmp_file}"' EXIT
        render_kanata_plist "${kanata_bin}" "${tmp_file}"

        if [[ ! -f "${KANATA_PLIST}" ]] || ! cmp -s "${tmp_file}" "${KANATA_PLIST}"; then
            sudo install -o root -g wheel -m 644 "${tmp_file}" "${KANATA_PLIST}"
            if sudo launchctl print "system/${KANATA_LABEL}" >/dev/null 2>&1; then
                sudo launchctl bootout "system/${KANATA_LABEL}" >/dev/null 2>&1 || true
            fi
        fi

        if ! sudo launchctl print "system/${KANATA_LABEL}" >/dev/null 2>&1; then
            sudo launchctl bootstrap system "${KANATA_PLIST}"
        fi
    )

    sudo launchctl enable "system/${KANATA_LABEL}" >/dev/null 2>&1 || true
    if ! sudo launchctl kickstart -k "system/${KANATA_LABEL}" >/dev/null 2>&1; then
        echo "Kanata daemon did not start. Inspect: sudo tail -n 50 /var/log/kanata.err.log" >&2
        return 1
    fi
}

provision_check_kanata_tcc() {
    local kanata_bin="${1:?kanata binary required}"
    local kanata_realpath
    local tcc_rows

    kanata_realpath="$(realpath "${kanata_bin}")"
    if ! tcc_rows="$(sudo sqlite3 "${TCC_DB}" "select service || '|' || client || '|' || auth_value from access where lower(client) like '%kanata%';" 2>/dev/null)"; then
        echo "Allow your terminal Full Disk Access so kbd can verify Kanata permissions, then rerun: kbd provision" >&2
        return 1
    fi

    if ! printf '%s\n' "${tcc_rows}" | grep -Fqx "kTCCServiceListenEvent|${kanata_realpath}|2"; then
        echo "Enable ${kanata_realpath} in System Settings > Privacy & Security > Input Monitoring, then rerun: kbd provision" >&2
        return 1
    fi
    if ! printf '%s\n' "${tcc_rows}" | grep -Fqx "kTCCServiceAccessibility|${kanata_realpath}|2"; then
        echo "Enable ${kanata_realpath} in System Settings > Privacy & Security > Accessibility, then rerun: kbd provision" >&2
        return 1
    fi
}

cmd_provision_runtime() {
    local kanata_bin

    cmd_provision_virtualhid
    kanata_bin="$(resolve_kanata_bin)"
    if [[ -z "${kanata_bin}" ]]; then
        echo "Kanata is missing. Run chezmoi apply, then rerun: kbd provision" >&2
        return 1
    fi
    provision_check_kanata_tcc "${kanata_bin}"
    cmd_provision_kanata "${kanata_bin}"
}

cmd_provision() {
    if [[ "$(uname -s)" != "Darwin" ]]; then
        echo "kbd provision supports macOS only." >&2
        return 1
    fi

    qmk_env_path
    cmd_provision_prerequisites
    cmd_provision_qmk
    sudo -v
    cmd_provision_runtime

    echo "keyboard provisioning complete"
    echo "qmk_firmware: ${QMK_DIR}"
    cmd_doctor
}

doctor_ok() {
    echo "ok: $*"
}

doctor_warn() {
    echo "warn: $*"
}

doctor_fail() {
    echo "fail: $*"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
}

resolve_kanata_bin() {
    if [[ -x /opt/homebrew/bin/kanata ]]; then
        echo /opt/homebrew/bin/kanata
    elif [[ -x /usr/local/bin/kanata ]]; then
        echo /usr/local/bin/kanata
    elif command -v kanata >/dev/null 2>&1; then
        command -v kanata
    fi
}

doctor_check_kanata_tcc() {
    local kanata_bin="${1:?kanata binary required}"
    local kanata_realpath
    local tcc_db="/Library/Application Support/com.apple.TCC/TCC.db"
    local tcc_rows
    local stale_rows

    if ! command -v realpath >/dev/null 2>&1; then
        doctor_warn "realpath is unavailable; skipping Kanata TCC path check"
        return 0
    fi
    kanata_realpath="$(realpath "${kanata_bin}")"

    if [[ ! -r "${tcc_db}" ]] || ! command -v sqlite3 >/dev/null 2>&1; then
        doctor_warn "cannot read system TCC database; inspect Input Monitoring and Accessibility manually"
        return 0
    fi

    tcc_rows="$(sqlite3 "${tcc_db}" "select service || '|' || client || '|' || auth_value from access where lower(client) like '%kanata%' order by service, client;" 2>/dev/null || true)"
    if printf '%s\n' "${tcc_rows}" | grep -Fqx "kTCCServiceListenEvent|${kanata_realpath}|2"; then
        doctor_ok "Kanata has Input Monitoring for ${kanata_realpath}"
    else
        doctor_fail "Kanata is missing Input Monitoring for ${kanata_realpath}"
        echo "  enable ${kanata_realpath} in System Settings > Privacy & Security > Input Monitoring"
    fi

    if printf '%s\n' "${tcc_rows}" | grep -Fqx "kTCCServiceAccessibility|${kanata_realpath}|2"; then
        doctor_ok "Kanata has Accessibility for ${kanata_realpath}"
    else
        doctor_fail "Kanata is missing Accessibility for ${kanata_realpath}"
        echo "  enable ${kanata_realpath} in System Settings > Privacy & Security > Accessibility"
    fi

    stale_rows="$(printf '%s\n' "${tcc_rows}" | awk -F'|' -v current="${kanata_realpath}" 'NF == 3 && $2 != current { print $1 " -> " $2 }')"
    if [[ -n "${stale_rows}" ]]; then
        doctor_warn "stale Kanata TCC grants exist:"
        printf '%s\n' "${stale_rows}" | sed 's/^/  /'
    fi
}

doctor_check_karabiner_runtime() {
    local virtualhid_label="org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon"
    local legacy_virtualhid_label="org.pqrs.Karabiner-VirtualHIDDevice-Daemon.chezmoi"
    local legacy_virtualhid_plist="/Library/LaunchDaemons/${legacy_virtualhid_label}.plist"
    local core_label="org.pqrs.service.daemon.Karabiner-Core-Service"
    local legacy_core_plist="/Library/LaunchDaemons/${core_label}.plist"
    local rootonly_dir="/Library/Application Support/org.pqrs/tmp/rootonly"
    local virtualhid_log="/var/log/karabiner/virtual_hid_device_service.log"
    local virtualhid_recent_log=""
    local legacy_virtualhid_running=0

    if systemextensionsctl list 2>/dev/null | grep -q "org.pqrs.Karabiner-DriverKit-VirtualHIDDevice.*activated enabled"; then
        doctor_ok "Karabiner DriverKit VirtualHID extension is activated"
    else
        doctor_fail "Karabiner DriverKit VirtualHID extension is not activated"
    fi

    if launchctl print "system/${virtualhid_label}" >/dev/null 2>&1; then
        doctor_ok "Karabiner VirtualHID daemon is managed by Karabiner"
    else
        doctor_fail "Karabiner VirtualHID daemon is not running under ${virtualhid_label}"
    fi

    if launchctl print "system/${legacy_virtualhid_label}" >/dev/null 2>&1; then
        legacy_virtualhid_running=1
        doctor_fail "legacy chezmoi VirtualHID daemon is also running"
        echo "  fix:"
        echo "    sudo launchctl bootout system/${legacy_virtualhid_label} || true"
        echo "    sudo rm -f ${legacy_virtualhid_plist}"
    fi

    if [[ -f "${legacy_virtualhid_plist}" && "${legacy_virtualhid_running}" == "0" ]]; then
        doctor_fail "legacy chezmoi VirtualHID plist exists: ${legacy_virtualhid_plist}"
        echo "  fix: sudo rm -f ${legacy_virtualhid_plist}"
    fi

    if launchctl print "system/${core_label}" >/dev/null 2>&1; then
        doctor_ok "Karabiner Core-Service is running"
    else
        doctor_warn "Karabiner Core-Service is not visible under ${core_label}"
    fi

    if [[ -f "${legacy_core_plist}" ]]; then
        doctor_warn "legacy Karabiner Core-Service plist exists: ${legacy_core_plist}"
        echo "  cleanup: sudo rm -f ${legacy_core_plist}"
    fi

    if [[ -d "${rootonly_dir}" ]]; then
        doctor_ok "Karabiner root-only socket directory exists"
        if [[ ! -r "${rootonly_dir}" ]]; then
            doctor_warn "root-only socket directory requires sudo to inspect"
        fi
    else
        doctor_fail "Karabiner root-only socket directory is missing: ${rootonly_dir}"
    fi

    if [[ -r "${virtualhid_log}" ]]; then
        virtualhid_recent_log="$(tail -n 160 "${virtualhid_log}" 2>/dev/null || true)"
        if printf '%s\n' "${virtualhid_recent_log}" | grep -q "virtual_hid_device_service_server: bound"; then
            doctor_ok "Karabiner VirtualHID service bound its socket"
        else
            doctor_warn "Karabiner VirtualHID service log does not show a recent socket bind"
        fi

        if printf '%s\n' "${virtualhid_recent_log}" | grep -Eq "permissions error|bind_failed|driver_version_ is mismatched"; then
            doctor_fail "Karabiner VirtualHID service log contains backend errors"
            printf '%s\n' "${virtualhid_recent_log}" | grep -E "permissions error|bind_failed|driver_version_ is mismatched" | tail -n 8 | sed 's/^/  /'
        fi
    else
        doctor_warn "cannot read ${virtualhid_log}; inspect it with sudo if output still fails"
    fi
}

doctor_check_kanata_runtime() {
    local kanata_bin
    local kanata_config="${KANATA_CONFIG}"
    local karabiner_daemon="${KARABINER_DAEMON}"
    local kanata_status
    local kanata_backend_state
    local kanata_expects_old_socket=0
    local karabiner_uses_new_socket=0

    kanata_bin="$(resolve_kanata_bin)"
    if [[ -z "${kanata_bin}" ]]; then
        doctor_fail "kanata is not installed"
        return 0
    fi
    doctor_ok "kanata binary: ${kanata_bin}"

    if [[ -f "${kanata_config}" ]]; then
        if "${kanata_bin}" --check --cfg "${kanata_config}" >/dev/null 2>&1; then
            doctor_ok "Kanata config is valid"
        else
            doctor_fail "Kanata config check failed: ${kanata_config}"
        fi
    else
        doctor_fail "Kanata config is missing: ${kanata_config}"
    fi

    doctor_check_kanata_tcc "${kanata_bin}"

    kanata_status="$(launchctl print system/com.kanata.daemon 2>/dev/null || true)"
    if printf '%s\n' "${kanata_status}" | grep -q "state = running"; then
        doctor_ok "Kanata launch daemon is running"
    else
        doctor_fail "Kanata launch daemon is not running"
    fi

    if [[ -r /var/log/kanata.log ]]; then
        kanata_backend_state="$(
            tail -n 160 /var/log/kanata.log | awk '
                /connect_failed asio.system:2/ { state = "connect_failed" }
                /virtual_hid_keyboard_ready true|cleared stale virtual HID keyboard state/ { state = "ready" }
                END { print state }
            '
        )"
    fi

    if [[ "${kanata_backend_state}" == "ready" ]]; then
        doctor_ok "Kanata VirtualHID output backend is connected"
    elif [[ "${kanata_backend_state}" == "connect_failed" ]]; then
        doctor_fail "Kanata cannot connect to the Karabiner VirtualHID output backend"
        if command -v strings >/dev/null 2>&1; then
            if grep -q "vhidd_server" < <(strings -a "${kanata_bin}" 2>/dev/null); then
                kanata_expects_old_socket=1
            fi
            if [[ -x "${karabiner_daemon}" ]] && grep -q "karabiner_virtual_hid_device_service.sock" < <(strings -a "${karabiner_daemon}" 2>/dev/null); then
                karabiner_uses_new_socket=1
            fi
        fi
        if [[ "${kanata_expects_old_socket}" == "1" && "${karabiner_uses_new_socket}" == "1" ]]; then
            doctor_fail "Kanata and Karabiner VirtualHID use different socket protocols"
            echo "  kanata expects: /Library/Application Support/org.pqrs/tmp/rootonly/vhidd_server/*.sock"
            echo "  karabiner provides: /Library/Application Support/org.pqrs/tmp/rootonly/karabiner_virtual_hid_device_service.sock"
        fi
        echo "  inspect:"
        echo "    sudo find \"/Library/Application Support/org.pqrs/tmp/rootonly\" -maxdepth 3 -ls"
        echo "    sudo lsof -nP -U | grep -Ei 'karabiner_virtual_hid_device_service|kanata|rootonly'"
        echo "  recover:"
        echo "    sudo launchctl kickstart -k system/org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon"
        echo "    sudo launchctl kickstart -k system/com.kanata.daemon"
    fi
}

cmd_doctor() {
    DOCTOR_FAILURES=0
    echo "kbd doctor"

    if [[ "$(uname -s)" != "Darwin" ]]; then
        doctor_warn "macOS runtime checks skipped on $(uname -s)"
    else
        doctor_check_karabiner_runtime
        doctor_check_kanata_runtime
    fi

    if [[ "${DOCTOR_FAILURES}" -gt 0 ]]; then
        echo "kbd doctor found ${DOCTOR_FAILURES} failure(s)"
        return 1
    fi

    echo "kbd doctor passed"
}

cmd_layout_images() {
    if [[ ! -f "${KEYMAP_C}" ]]; then
        echo "missing keymap source: ${KEYMAP_C}" >&2
        exit 1
    fi

    if [[ ! -f "${KEYMAP_CFG}" ]]; then
        echo "missing keymap-drawer config: ${KEYMAP_CFG}" >&2
        exit 1
    fi

    if ! resolve_qmk_runner >/dev/null 2>&1; then
        echo "qmk CLI not found. Run chezmoi apply, then rerun: kbd provision" >&2
        exit 1
    fi

    if ! command -v keymap >/dev/null 2>&1; then
        echo "keymap-drawer CLI not found. Run chezmoi apply, then rerun: kbd provision" >&2
        exit 1
    fi

    if ! command -v rsvg-convert >/dev/null 2>&1; then
        echo "rsvg-convert not found. Run chezmoi apply, then rerun: kbd provision" >&2
        exit 1
    fi

    mkdir -p "${IMAGE_DIR}"

    tmpdir="$(mktemp -d)"
    trap 'rm -rf "${tmpdir}"' RETURN

    json_file="${tmpdir}/keymap.json"
    yaml_file="${IMAGE_DIR}/keymap.yaml"
    full_svg="${IMAGE_DIR}/keymap.svg"

    run_qmk c2json "${KEYMAP_C}" -kb "${KEYBOARD}" -km "${KEYMAP_NAME}" -q -o "${json_file}"
    keymap -c "${KEYMAP_CFG}" parse -q "${json_file}" -o "${yaml_file}"
    keymap -c "${KEYMAP_CFG}" draw "${yaml_file}" -o "${full_svg}"

    for pair in "L0:layer0" "L1:layer1" "L2:layer2" "L3:layer3"; do
        layer="${pair%%:*}"
        name="${pair##*:}"
        layer_svg="${IMAGE_DIR}/${name}.svg"
        layer_png="${IMAGE_DIR}/${name}.png"

        keymap -c "${KEYMAP_CFG}" draw "${yaml_file}" -s "${layer}" -o "${layer_svg}"
        rsvg-convert -f png -o "${layer_png}" "${layer_svg}"
    done

    echo "generated layout assets from: ${KEYMAP_C}"
    echo "full: ${full_svg}"
    echo "layers: ${IMAGE_DIR}/layer0.png ${IMAGE_DIR}/layer1.png ${IMAGE_DIR}/layer2.png ${IMAGE_DIR}/layer3.png"
}

cmd_hud_reload() {
    for f in layer0.png layer1.png layer2.png layer3.png; do
        if [[ ! -f "${IMAGE_DIR}/${f}" ]]; then
            echo "missing ${IMAGE_DIR}/${f}" >&2
            exit 1
        fi
    done

    open -a Hammerspoon

    if command -v hs >/dev/null 2>&1; then
        (hs -c 'hs.reload()' >/dev/null 2>&1 &) || true
    else
        echo "hs CLI not found. Restart Hammerspoon manually." >&2
        exit 1
    fi

    echo "hammerspoon reloaded"
}

cmd_sync() {
    if [[ ! -d "${KEYMAP_DIR}" ]]; then
        echo "missing source dir: ${KEYMAP_DIR}" >&2
        exit 1
    fi

    require_qmk_checkout
    mkdir -p "${QMK_KEYMAP_DIR}"
    rsync -a --delete "${KEYMAP_DIR}/" "${QMK_KEYMAP_DIR}/"

    echo "synced keymap to ${QMK_KEYMAP_DIR}"

    cmd_layout_images
    cmd_hud_reload || true
}

build_firmware() {
    local convert_to="${1:?convert target required}"
    local hand="${2:-}"
    local uf2_name="crkbd_rev1_ezra_corne_${convert_to}.uf2"
    local uf2_path="${QMK_DIR}/${uf2_name}"
    local output_path="${ARTIFACT_DIR}/${uf2_name}"
    local -a compile_args=(compile -c -kb "${KEYBOARD}" -km "${KEYMAP_NAME}" -e "CONVERT_TO=${convert_to}")

    case "${hand}" in
        "")
            ;;
        left)
            compile_args+=(-e INIT_EE_HANDS_LEFT=1)
            output_path="${ARTIFACT_DIR}/crkbd_rev1_ezra_corne_${convert_to}_left.uf2"
            ;;
        right)
            compile_args+=(-e INIT_EE_HANDS_RIGHT=1)
            output_path="${ARTIFACT_DIR}/crkbd_rev1_ezra_corne_${convert_to}_right.uf2"
            ;;
        *)
            echo "unknown hand: ${hand}" >&2
            exit 1
            ;;
    esac

    qmk_env_path
    cmd_sync
    require_qmk_checkout

    (
        cd "${QMK_DIR}"
        git submodule sync --recursive
        git submodule update --init --recursive
        QMK_HOME="${QMK_DIR}" run_qmk "${compile_args[@]}"
    )

    mkdir -p "${ARTIFACT_DIR}"
    if [[ ! -f "${uf2_path}" ]]; then
        echo "build finished but UF2 not found: ${uf2_path}" >&2
        exit 1
    fi

    cp -f "${uf2_path}" "${output_path}"
    echo "built ${output_path}"
}

cmd_build() {
    local convert_to="rp2040_ce"
    local hand=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --convert-to)
                require_value "$1" "${2:-}"
                convert_to="$2"
                shift 2
                ;;
            --left)
                [[ -z "${hand}" ]] || { echo "choose only one of --left or --right" >&2; exit 1; }
                hand="left"
                shift
                ;;
            --right)
                [[ -z "${hand}" ]] || { echo "choose only one of --left or --right" >&2; exit 1; }
                hand="right"
                shift
                ;;
            *)
                echo "unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    build_firmware "${convert_to}" "${hand}"
}

cmd_build_all() {
    build_firmware rp2040_ce
    build_firmware sparkfun_pm2040
    echo "all firmware targets built"
}

cmd_flash() {
    if [[ $# -lt 1 ]]; then
        echo "flash requires left or right" >&2
        exit 1
    fi

    local hand="$1"
    local convert_to="rp2040_ce"
    local dry_run=0
    shift

    case "${hand}" in
        left|right)
            ;;
        *)
            echo "flash target must be left or right" >&2
            exit 1
            ;;
    esac

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --convert-to)
                require_value "$1" "${2:-}"
                convert_to="$2"
                shift 2
                ;;
            -n|--dry-run)
                dry_run=1
                shift
                ;;
            *)
                echo "unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    qmk_env_path
    require_qmk_checkout

    local -a flash_args=(flash)
    if [[ "${dry_run}" == "1" ]]; then
        flash_args+=(-n)
    fi
    flash_args+=(-kb "${KEYBOARD}" -km "${KEYMAP_NAME}" -e "CONVERT_TO=${convert_to}" -bl "uf2-split-${hand}")

    cd "${QMK_DIR}"
    if [[ "${dry_run}" == "1" ]]; then
        QMK_HOME="${QMK_DIR}" run_qmk "${flash_args[@]}"
    else
        echo "Put ${hand^^} half in bootloader now (RPI-RP2 mounted), then flashing..."
        QMK_HOME="${QMK_DIR}" run_qmk "${flash_args[@]}"
    fi
}

cmd_open_artifacts() {
    mkdir -p "${ARTIFACT_DIR}"
    open "${ARTIFACT_DIR}"
}

main() {
    if [[ $# -lt 1 ]]; then
        usage
        exit 2
    fi

    command="$1"
    shift

    case "${command}" in
        provision)
            cmd_provision "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        sync)
            cmd_sync "$@"
            ;;
        build)
            cmd_build "$@"
            ;;
        build-all)
            cmd_build_all "$@"
            ;;
        flash)
            cmd_flash "$@"
            ;;
        layout-images)
            cmd_layout_images "$@"
            ;;
        hud-reload)
            cmd_hud_reload "$@"
            ;;
        open-artifacts)
            cmd_open_artifacts "$@"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo "unknown command: ${command}" >&2
            usage >&2
            exit 2
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
