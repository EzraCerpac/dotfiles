#!/usr/bin/env bash

set -euo pipefail

{{- if eq .profile "nas" }}
echo "CerpacNAS profile detected; skipping workstation tool reconciliation."
exit 0
{{- else }}

readonly DEFAULT_TOOL_PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH:/opt/homebrew/bin:/usr/local/bin"
export PATH="${TOOL_RECONCILE_PATH:-$DEFAULT_TOOL_PATH}"

readonly STATE_DIR="${TOOL_RECONCILE_STATE_DIR:-$HOME/.local/state/chezmoi/tool-reconcile}"
{{- if eq .chezmoi.os "darwin" }}
readonly PACKAGES_FINGERPRINT="{{ dict "profile" .profile "packages" .packages.darwin | toJson | sha256sum }}"
{{- else if eq .chezmoi.os "linux" }}
readonly PACKAGES_FINGERPRINT="{{ dict "profile" .profile "packages" .packages.linux | toJson | sha256sum }}"
{{- else }}
readonly PACKAGES_FINGERPRINT="{{ dict "profile" .profile "os" .chezmoi.os | toJson | sha256sum }}"
{{- end }}
readonly MISE_FINGERPRINT="{{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}"
readonly HERDR_FINGERPRINT="herdr:https://herdr.dev/install.sh:v1"
readonly KEYMAP_DRAWER_FINGERPRINT="uv-tool:keymap-drawer:latest"
readonly CODEX_ACP_FINGERPRINT="npm:@zed-industries/codex-acp:latest"
{{- if eq .chezmoi.os "darwin" }}
readonly AEGIS_VERSION="{{ .packages.darwin.managed_apps.aegis.version }}"
readonly AEGIS_BUNDLE_ID="{{ .packages.darwin.managed_apps.aegis.bundle_id }}"
readonly AEGIS_URL="{{ .packages.darwin.managed_apps.aegis.url }}"
readonly AEGIS_SHA256="{{ .packages.darwin.managed_apps.aegis.sha256 }}"
{{- end }}

marker_matches() {
    local name="${1:?adapter name required}"
    local fingerprint="${2:?fingerprint required}"
    local marker="$STATE_DIR/$name"

    [[ -f "$marker" ]] && [[ "$(<"$marker")" == "$fingerprint" ]]
}

write_marker() {
    local name="${1:?adapter name required}"
    local fingerprint="${2:?fingerprint required}"
    local marker="$STATE_DIR/$name"
    local temporary

    temporary="$(mktemp "$STATE_DIR/.${name}.XXXXXX")"
    printf '%s\n' "$fingerprint" >"$temporary"
    mv "$temporary" "$marker"
}

{{- if eq .profile "delftblue" }}
echo "DelftBlue profile detected; skipping workstation tool reconciliation."
exit 0
{{- end }}

mkdir -p "$STATE_DIR"

reconcile_packages() {
{{- if eq .chezmoi.os "darwin" }}
    local brew_bin="${BREW_BIN:-}"
    local brewfile

    if [[ -z "$brew_bin" ]]; then
        if [[ -x /opt/homebrew/bin/brew ]]; then
            brew_bin=/opt/homebrew/bin/brew
        elif [[ -x /usr/local/bin/brew ]]; then
            brew_bin=/usr/local/bin/brew
        elif command -v brew >/dev/null 2>&1; then
            brew_bin="$(command -v brew)"
        fi
    fi

    if [[ -z "$brew_bin" ]]; then
        echo "Warning: Homebrew not found; package reconciliation will retry next apply." >&2
        return 1
    fi

    brewfile="$(mktemp)"
    cat >"$brewfile" <<'BREWFILE'
{{- range .packages.darwin.taps }}
tap "{{ . }}"
{{- end }}
{{- range .packages.darwin.brews }}
brew "{{ . }}"
{{- end }}
{{- range .packages.darwin.casks }}
cask "{{ . }}"
{{- end }}
BREWFILE

    if marker_matches packages "$PACKAGES_FINGERPRINT" && "$brew_bin" bundle check --file="$brewfile" >/dev/null 2>&1; then
        rm -f "$brewfile"
        return 0
    fi

    eval "$("$brew_bin" shellenv)"
{{- range .packages.darwin.taps }}
    "$brew_bin" tap {{ quote . }} || true
{{- end }}
{{- range .packages.darwin.trusted_taps }}
    "$brew_bin" trust --tap {{ quote . }} || true
{{- end }}

    if "$brew_bin" bundle check --file="$brewfile" >/dev/null 2>&1; then
        rm -f "$brewfile"
        write_marker packages "$PACKAGES_FINGERPRINT"
        return 0
    fi

    if ! "$brew_bin" bundle install --file="$brewfile"; then
        rm -f "$brewfile"
        return 1
    fi
    rm -f "$brewfile"

{{- else if eq .chezmoi.os "linux" }}
    local package
    local missing=0

    if ! command -v apt-get >/dev/null 2>&1; then
        echo "Warning: apt-get not found; package reconciliation will retry next apply." >&2
        return 1
    fi

{{- range .packages.linux.apt }}
    package={{ quote . }}
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed' || missing=1
{{- end }}

    if [[ "$missing" -eq 0 ]]; then
        write_marker packages "$PACKAGES_FINGERPRINT"
        return 0
    fi

    sudo apt-get update -qq || return 1
    sudo apt-get install -y \
{{- range .packages.linux.apt }}
        {{ . }} \
{{- end }}
        || return 1
{{- else }}
    echo "Warning: unsupported OS; package reconciliation skipped." >&2
    return 1
{{- end }}

    write_marker packages "$PACKAGES_FINGERPRINT"
}

reconcile_mise() {
    if ! command -v mise >/dev/null 2>&1; then
        echo "Warning: mise not found; mise reconciliation will retry next apply." >&2
        return 1
    fi

    if marker_matches mise "$MISE_FINGERPRINT" && MISE_CONFIG_FILE="$HOME/.config/mise/config.toml" mise install --dry-run-code >/dev/null 2>&1; then
        return 0
    fi

    MISE_CONFIG_FILE="$HOME/.config/mise/config.toml" mise install --yes || return 1
    write_marker mise "$MISE_FINGERPRINT"
}

reconcile_herdr() {
    if marker_matches herdr "$HERDR_FINGERPRINT" && command -v herdr >/dev/null 2>&1; then
        return 0
    fi
    if [[ ! -f "$STATE_DIR/herdr" ]] && command -v herdr >/dev/null 2>&1; then
        write_marker herdr "$HERDR_FINGERPRINT"
        return 0
    fi

    curl -fsSL https://herdr.dev/install.sh | sh || return 1
    command -v herdr >/dev/null 2>&1 || return 1
    write_marker herdr "$HERDR_FINGERPRINT"
}

reconcile_keymap_drawer() {
    if marker_matches keymap-drawer "$KEYMAP_DRAWER_FINGERPRINT" && command -v keymap >/dev/null 2>&1; then
        return 0
    fi
    if [[ ! -f "$STATE_DIR/keymap-drawer" ]] && command -v keymap >/dev/null 2>&1; then
        write_marker keymap-drawer "$KEYMAP_DRAWER_FINGERPRINT"
        return 0
    fi
    if ! command -v mise >/dev/null 2>&1; then
        echo "Warning: mise not found; keymap-drawer reconciliation will retry next apply." >&2
        return 1
    fi

    mise exec uv -- uv tool install --upgrade keymap-drawer || return 1
    command -v keymap >/dev/null 2>&1 || return 1
    write_marker keymap-drawer "$KEYMAP_DRAWER_FINGERPRINT"
}

reconcile_codex_acp() {
    if marker_matches codex-acp "$CODEX_ACP_FINGERPRINT" && command -v codex-acp >/dev/null 2>&1; then
        return 0
    fi
    if [[ ! -f "$STATE_DIR/codex-acp" ]] && command -v codex-acp >/dev/null 2>&1; then
        write_marker codex-acp "$CODEX_ACP_FINGERPRINT"
        return 0
    fi
    if ! command -v npm >/dev/null 2>&1; then
        echo "Warning: npm not found; codex-acp reconciliation will retry next apply." >&2
        return 1
    fi

    npm install --global @zed-industries/codex-acp || return 1
    command -v codex-acp >/dev/null 2>&1 || return 1
    write_marker codex-acp "$CODEX_ACP_FINGERPRINT"
}

{{- if eq .chezmoi.os "darwin" }}
aegis_app_is_valid() {
    local app_path="${1:?app path required}"
    local plist="${app_path}/Contents/Info.plist"
    local plist_buddy_bin="${AEGIS_PLIST_BUDDY_BIN:-/usr/libexec/PlistBuddy}"
    local codesign_bin="${AEGIS_CODESIGN_BIN:-/usr/bin/codesign}"
    local ditto_bin="${AEGIS_DITTO_BIN:-/usr/bin/ditto}"
    local verification_dir=""
    local clean_copy=""

    [[ -d "$app_path" && ! -L "$app_path" && -f "$plist" ]] || return 1
    [[ "$("$plist_buddy_bin" -c 'Print :CFBundleIdentifier' "$plist" 2>/dev/null)" == "$AEGIS_BUNDLE_ID" ]] || return 1
    [[ "$("$plist_buddy_bin" -c 'Print :CFBundleShortVersionString' "$plist" 2>/dev/null)" == "$AEGIS_VERSION" ]] || return 1
    if "$codesign_bin" --verify --deep --strict --verbose=2 "$app_path" >/dev/null 2>&1; then
        return 0
    fi

    # macOS can attach provenance metadata after moving an app into
    # /Applications. Verify the sealed bundle again on a metadata-free copy;
    # the installed app itself is not modified or exempted from Gatekeeper.
    verification_dir="$(mktemp -d "${TMPDIR:-/tmp}/aegis-signature.XXXXXX")" || return 1
    clean_copy="${verification_dir}/Aegis.app"
    if ! "$ditto_bin" --noextattr --noqtn "$app_path" "$clean_copy" || \
        ! "$codesign_bin" --verify --deep --strict --verbose=2 "$clean_copy" >/dev/null 2>&1; then
        rm -rf "$verification_dir"
        return 1
    fi
    rm -rf "$verification_dir"
}

reconcile_aegis() {
    local applications_dir="${AEGIS_APPLICATIONS_DIR:-/Applications}"
    local target="${applications_dir}/Aegis.app"
    local temporary_dir=""
    local archive=""
    local candidate=""
    local previous=""
    local curl_bin="${AEGIS_CURL_BIN:-curl}"
    local shasum_bin="${AEGIS_SHASUM_BIN:-shasum}"
    local unzip_bin="${AEGIS_UNZIP_BIN:-unzip}"

    if aegis_app_is_valid "$target"; then
        return 0
    fi

    for command_name in "$curl_bin" "$shasum_bin" "$unzip_bin"; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            echo "Warning: ${command_name} not found; Aegis reconciliation will retry next apply." >&2
            return 1
        fi
    done

    temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/aegis.XXXXXX")" || return 1
    archive="${temporary_dir}/Aegis.app.zip"
    candidate="${temporary_dir}/Aegis.app"
    previous="${temporary_dir}/previous-Aegis.app"

    if ! "$curl_bin" --fail --location --retry 3 --output "$archive" "$AEGIS_URL" || \
        ! printf '%s  %s\n' "$AEGIS_SHA256" "$archive" | "$shasum_bin" -a 256 -c - || \
        ! "$unzip_bin" -q "$archive" -d "$temporary_dir" || \
        ! aegis_app_is_valid "$candidate"; then
        rm -rf "$temporary_dir"
        return 1
    fi

    if [[ -e "$target" && ( ! -d "$target" || -L "$target" ) ]]; then
        echo "Warning: refusing to replace unexpected Aegis target: $target" >&2
        rm -rf "$temporary_dir"
        return 1
    fi

    if ! mkdir -p "$applications_dir"; then
        echo "Warning: cannot create Aegis application directory: $applications_dir" >&2
        rm -rf "$temporary_dir"
        return 1
    fi

    if [[ -d "$target" ]] && ! mv "$target" "$previous"; then
        echo "Warning: cannot stage existing Aegis app for replacement." >&2
        rm -rf "$temporary_dir"
        return 1
    fi

    if ! mv "$candidate" "$target" || ! aegis_app_is_valid "$target"; then
        rm -rf "$target"
        [[ -d "$previous" ]] && mv "$previous" "$target" || true
        rm -rf "$temporary_dir"
        return 1
    fi

    rm -rf "$temporary_dir"
}

{{- end }}

if [[ "${TOOL_RECONCILE_LIB_ONLY:-0}" != "1" ]]; then
    echo "Reconciling managed tools..."

    failed=0
    reconcile_packages || failed=1
    reconcile_mise || failed=1
    reconcile_herdr || failed=1
    reconcile_keymap_drawer || failed=1
    reconcile_codex_acp || failed=1
{{- if eq .chezmoi.os "darwin" }}
    reconcile_aegis || failed=1
{{- end }}

    if [[ "$failed" -ne 0 ]]; then
        echo "Warning: some tool adapters failed; they will retry next apply." >&2
    else
        echo "Managed tool reconciliation complete"
    fi
fi
{{- end }}
